# Python
__pycache__/
*.pyc
*.pyo

# Editor / IDE / tooling state
.*cache/

# Hidden service keys — NEVER commit these
# If you accidentally stage them: git rm --cached -r tor-keys/ tor-data/
tor-keys/
tor-data/

# Local compose overrides
docker-compose.override.yml

# Environment files
.env
.env.*

# OS / IDE
.DS_Store
*.swp


# Python venv (dev/test only)
.venv/

# Coverage / test artifacts
.coverage
coverage.json
coverage.txt
htmlcov/

# CI security reports (uploaded as an artifact, not committed)
security-reports/
.pytest_cache/
.hypothesis/
mutants/
.mutmut-cache
.mutmut-cache/

# The evidence bundle is generated per-release and signed alongside the
# image digest; it is not committed (it would be stale the next commit).
evidence/
