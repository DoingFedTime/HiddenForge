def cmd_info(args) -> int:
    manifest = build_manifest()
    if args.json:
        print(json.dumps(manifest, indent=2, sort_keys=True))
        return EXIT_OK
    print(f"{manifest['name']} {manifest['version']} (contract {manifest['contract_version']})")
    print(f"  image:   {manifest['image']}")
    print(f"  tor:     {manifest['tor_version']}")
    print(f"  address: {manifest['address']['command']}")
    print(f"  health:  {manifest['health']['command']}"
          f" (field: {manifest['health']['ready_field']})")
    print(f"  keys:    {manifest['volumes'][0]['path']}"
          f" -> {manifest['volumes'][0]['host_suggestion']}")
    return EXIT_OK


def cmd_version(args) -> int:
    if args.json:
        return emit_json(EXIT_OK, name="hiddenforge", version=HIDDENFORGE_VERSION,
                         contract_version=CONTRACT_VERSION)
    print(f"hiddenforge {HIDDENFORGE_VERSION} (contract {CONTRACT_VERSION})")
    return EXIT_OK


# ---------------------------------------------------------------------------
# show
# ---------------------------------------------------------------------------

def _fill_from_container(entry: dict, container: str | None) -> dict:
    """Ask the container for an address the host cannot read.

    Under rootless Podman the key directory belongs to a subuid and the
    published `<name>.onion` is never written, so from the host `show` could
    never answer, and the documented flow -- poll `status` until ready, then
    read the address with `show` -- dead-ended on the runtime recommended for
    high-risk deployments. The container can read it as the tor user, which is
    what `status` already does. Only an address the host could not read at all
    is filled; a host-side inconsistency is never overruled.
    """
    if container is None or entry["onion"] is not None or entry["source"] is not None:
        return entry
    resolved = _resolve_container(container)
    text = (_docker_exec_text(resolved, ["cat", f"{KEYS_IN_IMAGE}/{entry['name']}/hostname"])
            if resolved else None)
    onion = (text or "").strip()
    if ONION_RE.fullmatch(onion):
        entry = {**entry, "onion": onion, "source": "container"}
    return entry


def cmd_show(args) -> int:
    keys = Path(args.keys)
    container = getattr(args, "container", None)
    try:
        if container is not None:
            validate_container(container)
        if args.name:
            validate_name(args.name)
            entry = _fill_from_container(address_for(keys, args.name), container)
            if entry["source"] == "inconsistent":
                return emit_json(EXIT_FAIL, **entry, keys=str(keys),
                                 error=_inconsistent_error(entry))
            if entry["onion"] is None:
                return emit_json(EXIT_NOT_READY, name=args.name, onion=None,
                                 key_path=entry["key_path"], keys=str(keys),
                                 error=_not_ready_error(keys, args.name))
            if args.json:
                return emit_json(EXIT_OK, **entry)
            print(f"{entry['name']} {entry['onion']}")
            return EXIT_OK
        entries = [_fill_from_container(address_for(keys, n), container)
                   for n in service_names(keys)]
    except ValueError as exc:
        return emit_json(EXIT_USAGE, error=str(exc))

    if not keys.is_dir():
        return emit_json(EXIT_USAGE, keys=str(keys),
                         error=f"key directory {keys} does not exist")
    if not args.name and not entries:
        # Not listable (0751 by design) and no explicit name: say so clearly
        # rather than reporting an empty volume.
        return emit_json(EXIT_USAGE, keys=str(keys),
                         error=f"cannot enumerate services in {keys} (the key volume "
                               "is 0751, traverse-only); pass --name <service>")

    inconsistent = [e for e in entries if e["source"] == "inconsistent"]
    if inconsistent:
        rc = EXIT_FAIL
    elif entries and not all(e["onion"] for e in entries):
        rc = EXIT_NOT_READY
    else:
        rc = EXIT_OK
    if args.json:
        doc: dict = {"keys": str(keys), "addresses": entries,
                     "address": entries[0]["onion"] if entries else None}
        if inconsistent:
            doc["error"] = "; ".join(_inconsistent_error(e) for e in inconsistent)
        return emit_json(rc, **doc)
    for e in entries:
        if e["source"] == "inconsistent":
            print(f"{e['name']} (INCONSISTENT KEY SET - no address reported)")
            _eprint(f"error: {_inconsistent_error(e)}")
        else:
            print(f"{e['name']} {e['onion'] or '(not generated yet)'}")
    if not entries:
        _eprint(f"no services found in {keys}")
    return rc


def _not_ready_error(keys: Path, name: str) -> str:
    """Why there is no address, as precisely as the host can tell.

    "Not generated yet" was the only answer, and under rootless Podman it is
    false: the key exists, but its directory belongs to the tor user's subuid and
    the published `<name>.onion` is never written (the supervisor holds no
    DAC_OVERRIDE to read `hostname`). A caller told "not generated yet" waits for
    ever. The exit code stays 4, because on Docker the same unreadable directory is
    the ordinary state until the address is published.
    """
    d = keys / name
    if not d.is_dir():
        return "address not generated yet (no key directory for this service)"
    if not os.access(d, os.R_OK | os.X_OK):
        return (f"address not published yet: {d} exists but is not readable by this "
                f"user, and {keys / (name + '.onion')} does not exist. Under Docker it "
                "appears once the service is reachable. Under rootless Podman it is "
                "never written; pass --container <name> to read the address from "
                "inside the container.")
    return "address not generated yet (Tor has not written hostname)"


def _inconsistent_error(entry: dict) -> str:
    return (f"{entry['name']}: the hostname file says {entry['hostname_onion']} but the "
            f"public key is {entry['derived_onion']}. Tor serves the key's address and "
            "rewrites hostname at startup, so the file is wrong. The directory holds "
            "files from two key sets (a partial restore or copy): restore the whole "
            "directory from one backup before publishing any address.")


# ---------------------------------------------------------------------------
# status
# ---------------------------------------------------------------------------

def _in_container() -> bool:
    """True when this CLI is running inside the hiddenforge image.

    The image deliberately ships no crypto tooling (backup/restore/encrypt-key/
    decrypt-key need age or gpg), so the error for a missing tool must tell an
    in-container user to run the command on the host, where it can work, rather
    than to 'install' something into a read-only image.
    """
    if os.environ.get("HIDDENFORGE_IN_CONTAINER") == "1":
        return True
    return os.path.exists(TORRC_PATH)


def _no_tool_error() -> str:
    msg = "no encryption tool found: install `age` (preferred) or `gpg`"
    if _in_container():
        msg += (". The hiddenforge image ships no crypto tooling on purpose; run "
                "this command on the HOST that holds your backup, not with docker exec")
    return msg


def _resolve_container(container: str) -> str | None:
    """Resolve a container reference: exact id/name, else Compose service label.

    With Docker Compose the container is named `<project>-<service>-1`, so
    `docker inspect tor` fails even though the service is running. Fall back to
    the compose service label (Docker's, then podman-compose's) so
    `hiddenforge status` works out of the box under either engine.
    """
    eng = _engine()
    if eng is None:
        return None
    if _run([eng, "inspect", container]).returncode == 0:
        return container
    for label in ("com.docker.compose.service", "io.podman.compose.service"):
        proc = _run([eng, "ps", "--filter", f"label={label}={container}",
                     "--format", "{{.ID}}"])
        ids = [line.strip() for line in proc.stdout.splitlines() if line.strip()]
        if ids:
            return ids[0]
    return None


def _docker_inspect(container: str) -> tuple[dict | None, str | None]:
    eng = _engine()
    if eng is None:
        return None, "neither docker nor podman found on PATH"
    resolved = _resolve_container(container)
    if resolved is None:
        return None, f"container or compose service {container!r} not found"
    proc = _run([eng, "inspect", resolved])
    if proc.returncode != 0:
        return None, (proc.stderr.strip() or f"container {container!r} not found")
    try:
        doc = json.loads(proc.stdout)
    except json.JSONDecodeError as exc:
        return None, f"could not parse docker inspect output: {exc}"
    if not doc:
        return None, f"container {container!r} not found"
    return doc[0], None


def _docker_exec_json(container: str, argv: list[str]) -> dict | None:
    """Best-effort in-container JSON query; returns None if unavailable."""
    eng = _engine()
    if eng is None or container is None:
        return None
    candidates = [
        [eng, "exec", container, *argv],
        [eng, "exec", container, "su-exec", "tor", *argv],
    ]
    for cmd in candidates:
        proc = _run(cmd)
        # Accept the doc even on a non-zero exit: healthcheck exits 1 when the
        # service is not ready yet, but still prints the granular state we want.
        if proc.stdout.strip():
            try:
                return json.loads(proc.stdout)
            except json.JSONDecodeError:
                continue
    return None


def cmd_status(args) -> int:
    container = args.container
    try:
        validate_container(container)
    except ValueError as exc:
        return emit_json(EXIT_USAGE, error=str(exc))

    info, err = _docker_inspect(container)
    if info is None:
        return emit_json(EXIT_USAGE, container=container, running=False,
                         ready=False, error=err)

    state = info.get("State", {}) or {}
    running = bool(state.get("Running"))
    health = (state.get("Health") or {}).get("Status")  # healthy|unhealthy|starting|None
    started = state.get("StartedAt")
    restarts = info.get("RestartCount")

    # Granular readiness from the in-container healthcheck, if reachable.
    resolved = _resolve_container(container)
    # As the tor user, exactly as the image's own HEALTHCHECK runs it. Run as
    # root it cannot reach the control socket in the tor-owned 0700 DataDirectory
    # wherever root lacks DAC_OVERRIDE (rootless Podman), and its "cannot reach
    # control socket" answer was accepted as the state of a working service.
    hc = (_docker_exec_json(resolved, ["su-exec", "tor", "python3",
                                       "/usr/local/bin/healthcheck.py", "--json"])
          if resolved else None)
    if hc is not None:
        bootstrapped = hc.get("tor_bootstrapped")
        published = hc.get("hidden_service_published")
        vanguards = hc.get("vanguards")
        reason = hc.get("reason")
    else:
        bootstrapped = health == "healthy" if health else None
        published = None
        vanguards = None
        reason = None

    # Addresses: prefer the host key volume; fall back to the in-container
    # healthcheck's list (it reads service names from the torrc, so it works even
    # when the 0751 key volume cannot be listed from the host).
    keys = Path(args.keys)
    entries = ([address_for(keys, n) for n in service_names(keys)]
               if keys.is_dir() else [])
    addresses = [{"name": e["name"], "onion": e["onion"]} for e in entries]
    hc_addr = {s.get("name"): s.get("address")
               for s in ((hc or {}).get("services") or []) if isinstance(s, dict)}
    if not addresses:
        addresses = [{"name": n, "onion": a} for n, a in hc_addr.items()]
    else:
        # Fill in only what the host could not read at all (source None): under
        # rootless Podman the key directory belongs to a subuid and <name>.onion
        # is never written, so every host-side address is None and `ready` could
        # never become true. A host-side INCONSISTENCY is never overruled.
        for a, e in zip(addresses, entries, strict=True):
            if a["onion"] is None and e["source"] is None:
                a["onion"] = hc_addr.get(a["name"])
    if published is None:
        published = bool(addresses) and all(a["onion"] for a in addresses)

    # Skipped/dropped mappings recorded by the entrypoint (i2pforge parity).
    dropped_raw = (_docker_exec_text(resolved, ["cat", "/var/lib/tor/dropped-mappings"])
                   if resolved else None)
    dropped_mappings = [ln for ln in (dropped_raw or "").splitlines() if ln.strip()]

    # No engine health status at all means no healthcheck ran -- Podman runs them
    # through systemd timers, and a host without a systemd user session never
    # does. The in-container healthcheck just run above IS that check, so its
    # verdict stands in; an engine that does report a status is still believed.
    # "starting" only means the engine has not recorded a result yet. Under
    # Podman without a systemd user session it never will -- healthchecks run
    # from systemd timers -- and it stayed "starting" for good, measured, while
    # the service was ready. The probe run above is the identical script, so
    # its verdict stands in until the engine has one of its own; an engine that
    # says "unhealthy" is still believed.
    if health in (None, "", "starting"):
        healthy = bool(hc is not None and hc.get("ready") is True)
    else:
        healthy = health == "healthy"
    ready = bool(running and healthy and published and addresses
                 and all(a["onion"] for a in addresses))
    if not ready and not reason:
        # `ready` is an AND, and the in-container healthcheck only speaks for its
        # own part of it. Measured: the service published and the healthcheck
        # said ready while Docker's health status was still "starting" (it
        # re-runs only every 60s), so `status` answered not-ready with no reason.
        # Name the condition that is actually missing.
        inconsistent = [e for e in (address_for(keys, a["name"]) for a in addresses
                                    if keys.is_dir() and a.get("name")
                                    and NAME_RE.fullmatch(str(a["name"])))
                        if e["source"] == "inconsistent"]
        if inconsistent:
            reason = "; ".join(_inconsistent_error(e) for e in inconsistent)
        elif not running:
            reason = "the container is not running"
        elif not healthy:
            reason = (f"the engine's health status is {health!r}, not 'healthy'"
                      + ("; it re-runs the healthcheck every 60s, so this follows "
                         "the in-container state shortly" if health == "starting"
                         else ""))
        elif not addresses:
            reason = "no service address could be read"
        else:
            reason = "not every service has a published address yet"

    doc = {
        "container": container,
        "status": state.get("Status"),
        "running": running,
        "healthy": healthy,
        "health_status": health,
        "tor_bootstrapped": bootstrapped,
        "vanguards": vanguards,
        "hidden_service_published": published,
        "addresses": addresses,
        "address": addresses[0]["onion"] if addresses else None,
        "started": started,
        "restarts": restarts,
        "ready": ready,
        "reason": reason,
        "dropped_mappings": dropped_mappings,
    }

    if args.json:
        return emit_json(EXIT_OK if ready else EXIT_NOT_READY, **doc)

    print(f"container:  {container}")
    print(f"state:      {doc['status']} (running={running}, health={health}, "
          f"restarts={restarts})")
    print(f"bootstrapped: {bootstrapped}  published: {published}  vanguards: {vanguards}")
    for a in addresses:
        print(f"address:    {a['name']} {a['onion'] or '(pending)'}")
    if reason:
        print(f"reason:     {reason}")
    for d in dropped_mappings:
        print(f"dropped mapping: {d}")
    print(f"ready:      {ready}")
    return EXIT_OK if ready else EXIT_NOT_READY


# ---------------------------------------------------------------------------
# doctor
# ---------------------------------------------------------------------------

def _as_int(value):
    """int(), or None for engine-supplied junk.

    docker/podman inspect values are typed by the engine, not by us: a missing
    key, an empty string, or a non-numeric string must degrade to a clean check
    result rather than a traceback that takes down the whole command.
    """
    try:
        return int(value)
    except (TypeError, ValueError):
        return None


def _check(ok: bool, name: str, detail: str, severity: str = "fail") -> dict:
    return {"check": name, "ok": bool(ok), "detail": detail, "severity": severity}


def _is_rootless() -> bool:
    """True only when the engine REPORTS it is running rootless.

    Asked, not assumed, and it fails towards more checking: anything other than a
    clear "true" leaves the strict five-capability requirement in force, so a
    broken query can only make `doctor` stricter, never quieter.
    """
    eng = _engine()
    if eng is None:
        return False
    proc = _run([eng, "info", "--format", "{{.Host.Security.Rootless}}"])
    if proc.returncode != 0:
        return False
    return proc.stdout.strip().lower() == "true"


# Linux capability numbers, for reading a measured bounding set back as names.
_LINUX_CAPS = (
    "CHOWN", "DAC_OVERRIDE", "DAC_READ_SEARCH", "FOWNER", "FSETID", "KILL", "SETGID",
    "SETUID", "SETPCAP", "LINUX_IMMUTABLE", "NET_BIND_SERVICE", "NET_BROADCAST",
    "NET_ADMIN", "NET_RAW", "IPC_LOCK", "IPC_OWNER", "SYS_MODULE", "SYS_RAWIO",
    "SYS_CHROOT", "SYS_PTRACE", "SYS_PACCT", "SYS_ADMIN", "SYS_BOOT", "SYS_NICE",
    "SYS_RESOURCE", "SYS_TIME", "SYS_TTY_CONFIG", "MKNOD", "LEASE", "AUDIT_WRITE",
    "AUDIT_CONTROL", "SETFCAP", "MAC_OVERRIDE", "MAC_ADMIN", "SYSLOG", "WAKE_ALARM",
    "BLOCK_SUSPEND", "AUDIT_READ", "PERFMON", "BPF", "CHECKPOINT_RESTORE",
)


def _caps_from_mask(mask: int) -> set[str]:
    return {(_LINUX_CAPS[b] if b < len(_LINUX_CAPS) else f"CAP_{b}")
            for b in range(64) if (mask >> b) & 1}


def _runtime_state(container: str | None) -> dict:
    """What the running container actually has, read from inside it.

    The engines describe the same configuration differently -- Podman reports
    `cap_drop: ALL` + `cap_add` as the explicit list of dropped capabilities
    with an empty CapAdd, so a doctor reading engine config reported a correct
    Podman container as missing CHOWN/SETUID/SETGID -- and an engine's config
    is not proof of what was applied: podman-compose silently drops
    pids_limit (before 1.1) and memswap_limit (every version). The container's
    own view is the same truth on every runtime: PID 1's capability bounding
    set, and the cgroup's pids.max and memory.swap.max. Empty values mean the
    file does not exist (a cgroup-v1 host) and the caller falls back.
    """
    script = ('echo "swap=$(cat /sys/fs/cgroup/memory.swap.max 2>/dev/null)"; '
              'echo "pids=$(cat /sys/fs/cgroup/pids.max 2>/dev/null)"; '
              'echo "capbnd=$(sed -n "s/^CapBnd:[[:space:]]*//p" /proc/1/status)"; '
              'echo "hostswap=$(tail -n +2 /proc/swaps 2>/dev/null | wc -l)"')
    text = _docker_exec_text(container, ["sh", "-c", script]) if container else None
    state: dict = {}
    for line in (text or "").splitlines():
        key, _, value = line.partition("=")
        state[key.strip()] = value.strip()
    if "capbnd" in state:
        try:
            state["capbnd"] = int(state["capbnd"], 16)
        except ValueError:
            state["capbnd"] = None
    return state


def _caps_ok(caps) -> set[str]:
    out = set()
    for c in caps or []:
        out.add(str(c).upper().removeprefix("CAP_"))
    return out


def _docker_exec_text(container: str, argv: list[str]) -> str | None:
    """Best-effort in-container command capturing stdout; None if unavailable."""
    eng = _engine()
    if eng is None or container is None:
        return None
    for prefix in ([eng, "exec", container, "su-exec", "tor"],
                   [eng, "exec", container]):
        proc = _run([*prefix, *argv])
        if proc.returncode == 0:
            return proc.stdout
    return None


def _append_key_checks(checks: list[dict], keys: Path) -> list[str]:
    """Verify on-disk key hygiene. Reads only modes/sizes, never key bytes.

    Returns the services whose directories this user may not enter. From the
    host that is the normal, correct state of a running deployment -- each
    service directory is 0700 and owned by the container's `tor` user -- so it is
    not reported as a failure here; the caller checks those from inside the
    container instead. It used to be a FAIL for every service, which made
    `doctor` fail the project's own recommended Docker deployment.
    """
    closed: list[str] = []
    if not keys.is_dir():
        checks.append(_check(False, "key directory exists", f"{keys} not found"))
        return closed
    dirmode = stat.S_IMODE(os.lstat(keys).st_mode)
    # 0751 (traverse, not list) is the intended mode: execute is required so the
    # host user can read <name>.onion by known path; group/world read or write is
    # what must never be set.
    checks.append(_check(dirmode & 0o026 == 0,
                         "key volume is not group/world writable or world readable",
                         f"mode={oct(dirmode)}", severity="warn"))
    names = service_names(keys)
    if not names and keys.is_dir():
        checks.append(_check(True, "service key directories checked",
                             "key volume is not listable (0751 by design); run "
                             "`docker exec <container> hiddenforge doctor --keys-only` "
                             "to verify service dir/file modes", severity="warn"))
    for name in names:
        d = keys / name
        try:
            dmode = stat.S_IMODE(os.lstat(d).st_mode)
            smode = stat.S_IMODE(os.lstat(d / SECRET_FILE).st_mode)
        except PermissionError:
            closed.append(name)
            continue
        except OSError as exc:
            checks.append(_check(False, f"key modes for {name}", f"cannot stat: {exc}"))
            continue
        checks.append(_check(dmode == 0o700, f"key dir {name} is 0700",
                             f"mode={oct(dmode)}"))
        checks.append(_check(smode == 0o600, f"secret key {name} is 0600",
                             f"mode={oct(smode)}"))
        entry = address_for(keys, name)
        if entry["derived_matches"] is False:
            checks.append(_check(
                False, f"{name}: hostname file matches the public key",
                f"hostname says {entry['hostname_onion']}, the public key is "
                f"{entry['derived_onion']}; Tor serves the key's address"))
    return closed


def _append_in_container_key_checks(checks: list[dict], container: str | None,
                                    closed: list[str]) -> None:
    """Check the service directories the host may not enter, from inside.

    The container's own `doctor --keys-only` runs as the tor user, which owns
    those directories, so it can see the modes the host cannot. Only its checks
    for the services the host could not inspect are taken.
    """
    doc = (_docker_exec_json(container, ["su-exec", "tor", HF_IN_IMAGE, "doctor",
                                         "--keys-only", "--json"])
           if container else None)
    inner = doc.get("checks") if isinstance(doc, dict) else None
    if not isinstance(inner, list):
        checks.extend(_check(
            False, f"key modes for {name}",
            "the service directory belongs to the container's tor user and the "
            "container could not be asked; run `docker exec <container> su-exec "
            "tor hiddenforge doctor --keys-only`", severity="warn") for name in closed)
        return
    covered: set[str] = set()
    for c in inner:
        if not isinstance(c, dict) or not isinstance(c.get("check"), str):
            continue
        for n in closed:
            if (c["check"].startswith((f"key dir {n} ", f"secret key {n} ", f"{n}: "))
                    or c["check"] == f"key modes for {n}"):
                covered.add(n)
                checks.append(_check(bool(c.get("ok")),
                                     c["check"] + " (checked in container)",
                                     str(c.get("detail", "")),
                                     str(c.get("severity", "fail"))))
    # A service the container said nothing about was not checked by anyone.
    # Silence there used to read as a pass.
    checks.extend(_check(
        False, f"key modes for {n}",
        "the container's own check reported nothing for this service, so its "
        "key modes were not verified") for n in closed if n not in covered)


def cmd_doctor(args) -> int:
    container = args.container
    checks: list[dict] = []
    try:
        validate_container(container)
    except ValueError as exc:
        return emit_json(EXIT_USAGE, error=str(exc))

    info = None
    if not getattr(args, "keys_only", False):
        info, err = _docker_inspect(container)
        if info is None:
            return emit_json(EXIT_USAGE, container=container, error=err)
    else:
        # In-container mode: no docker socket; verify on-disk key hygiene alone.
        checks = []
        closed = _append_key_checks(checks, Path(args.keys))
        if closed:
            # No container to ask from here: say what could not be seen rather
            # than reporting a clean result over directories never inspected.
            _append_in_container_key_checks(checks, None, closed)
        failures = [c for c in checks if not c["ok"] and c["severity"] == "fail"]
        ok = not failures
        if args.json:
            return emit_json(EXIT_OK if ok else EXIT_FAIL, keys=str(args.keys), ok=ok,
                             failures=[c["check"] for c in failures], checks=checks)
        for c in checks:
            print(f"[{'ok  ' if c['ok'] else 'FAIL'}] {c['check']}: {c['detail']}")
        return EXIT_OK if ok else EXIT_FAIL

    hc = info.get("HostConfig", {}) or {}
    secopt = [str(s) for s in (hc.get("SecurityOpt") or [])]
    resolved = _resolve_container(container)
    runtime = _runtime_state(resolved)

    required = ROOTLESS_REQUIRED_CAP_ADD if _is_rootless() else REQUIRED_CAP_ADD
    if runtime.get("capbnd") is not None:
        granted = _caps_from_mask(runtime["capbnd"])
        source = f"measured in the container (CapBnd): {sorted(granted)}"
        extra = granted - REQUIRED_CAP_ADD
        missing = required - granted
    else:
        drop = _caps_ok(hc.get("CapDrop"))
        add = _caps_ok(hc.get("CapAdd"))
        checks.append(_check("ALL" in drop, "cap_drop includes ALL",
                             f"CapDrop={sorted(drop)}"))
        source = f"engine config CapAdd={sorted(add)}"
        extra = add - REQUIRED_CAP_ADD
        missing = required - add
    checks.append(_check(not extra, "cap_add stays within the allowed set",
                         source + (f"; unexpected: {sorted(extra)}" if extra else "")))
    checks.append(_check(not missing, "cap_add includes every required capability",
                         f"missing: {sorted(missing)}" if missing else "complete"))
    checks.append(_check(
        any("no-new-privileges" in s for s in secopt),
        "no-new-privileges is set", f"SecurityOpt={secopt}"))
    checks.append(_check(bool(hc.get("ReadonlyRootfs")),
                         "root filesystem is read-only",
                         f"ReadonlyRootfs={hc.get('ReadonlyRootfs')}"))
    # This check used to assert the OPPOSITE -- that seccomp=unconfined was set,
    # on the belief that Tor's Sandbox 1 needed it. That belief was wrong and is
    # now disproven on both runtimes: the Tor process carries two stacked filters
    # (the runtime's profile plus Tor's own) under docker-default and under
    # podman's default profile, bootstraps, and serves. Running unconfined leaves
    # the root supervisor with NO syscall filter at all, because Sandbox 1 is
    # in-process and covers Tor alone.
    checks.append(_check(
        not any("seccomp=unconfined" in s for s in secopt),
        "a runtime seccomp profile is applied (not unconfined)",
        f"SecurityOpt={secopt}"))

    apparmor = info.get("AppArmorProfile") or next(
        (s.split("=", 1)[1] for s in secopt if s.startswith("apparmor=")), "")
    # _docker_inspect above already required an engine, so this is belt-and-braces:
    # do not invoke a binary we have just established is not there.
    eng = _engine()
    dockerinfo = (_run([eng, "info", "--format", "{{json .SecurityOptions}}"])
                  if eng else None)
    host_has_apparmor = bool(dockerinfo and dockerinfo.returncode == 0
                             and "apparmor" in dockerinfo.stdout.lower())
    if host_has_apparmor:
        checks.append(_check(bool(apparmor) and apparmor != "unconfined",
                             "AppArmor profile is applied",
                             f"AppArmorProfile={apparmor!r}"))
    else:
        checks.append(_check(True, "AppArmor profile is applied",
                             "host has no AppArmor; skipped", severity="warn"))

    if runtime.get("pids"):
        pids = _as_int(runtime["pids"])     # "max" -> None: no limit applied
        pids_detail = f"measured pids.max={runtime['pids']}"
    else:
        pids = _as_int(hc.get("PidsLimit"))
        pids_detail = f"engine config PidsLimit={hc.get('PidsLimit')!r}"
    checks.append(_check(pids is not None and 0 < pids <= 512,
                         "process count is capped at 512 or fewer",
                         pids_detail + ("" if pids is not None and 0 < pids <= 512 else
                                        "; podman-compose applies pids_limit only from "
                                        "version 1.1")))

    name = "swap is disabled (process memory cannot be paged to disk)"
    if runtime.get("swap"):
        if runtime["swap"] == "0":
            checks.append(_check(True, name, "measured memory.swap.max=0"))
        elif _as_int(runtime.get("hostswap")) == 0:
            checks.append(_check(False, name,
                                 f"memory.swap.max={runtime['swap']}, but the host has "
                                 "no active swap, so nothing can be paged today",
                                 severity="warn"))
        else:
            checks.append(_check(False, name,
                                 f"memory.swap.max={runtime['swap']} and the host has "
                                 "swap. Set memswap_limit equal to mem_limit (Docker); "
                                 "podman-compose cannot set it at all, so under Podman "
                                 "disable swap on the host"))
    else:
        mem = _as_int(hc.get("Memory")) or 0
        memswap = _as_int(hc.get("MemorySwap")) or 0
        checks.append(_check(mem > 0 and memswap == mem, name,
                             f"Memory={hc.get('Memory')!r} "
                             f"MemorySwap={hc.get('MemorySwap')!r}"))

    ports = (info.get("NetworkSettings") or {}).get("Ports") or {}
    published = {p: b for p, b in ports.items() if b}
    checks.append(_check(not published, "no public port bindings",
                         f"Ports={published or '{}'}"))

    logdriver = (hc.get("LogConfig") or {}).get("Type")
    checks.append(_check(logdriver == "none", "logging driver is 'none' (no host log)",
                         f"LogConfig.Type={logdriver!r}", severity="warn"))

    # The generated torrc must still carry every hardening directive. Docker
    # flags do not prove the Tor config was not weakened, and a compromised or
    # reconstructed /etc/tor/torrc would otherwise pass doctor silently.
    torrc = _docker_exec_text(resolved, ["cat", "/etc/tor/torrc"]) if resolved else None
    if torrc is None:
        checks.append(_check(True, "generated torrc is readable",
                             "could not read /etc/tor/torrc (container stopping?)",
                             severity="warn"))
    else:
        missing_directives = [d for d in HARDENING_DIRECTIVES if d not in torrc]
        checks.append(_check(
            not missing_directives, "generated torrc contains every hardening directive",
            "missing: " + "; ".join(missing_directives) if missing_directives else "all present"))

    # On-disk key hygiene: from the host where it can see, from inside the
    # container for the service directories only the tor user may enter.
    closed = _append_key_checks(checks, Path(args.keys))
    if closed:
        _append_in_container_key_checks(checks, resolved, closed)
    failures = [c for c in checks if not c["ok"] and c["severity"] == "fail"]
    warnings = [c for c in checks if not c["ok"] and c["severity"] == "warn"]
    ok = not failures

    if args.json:
        return emit_json(EXIT_OK if ok else EXIT_FAIL, container=container, ok=ok,
                         failures=[c["check"] for c in failures],
                         warnings=[c["check"] for c in warnings], checks=checks)
    for c in checks:
        mark = "ok  " if c["ok"] else ("WARN" if c["severity"] == "warn" else "FAIL")
        print(f"[{mark}] {c['check']}: {c['detail']}")
    print(f"\n{'PASS' if ok else 'FAIL'}"
          + (f" ({len(warnings)} warning(s))" if warnings else ""))
    return EXIT_OK if ok else EXIT_FAIL


# ---------------------------------------------------------------------------
# setup: compose fragment + deploy script + README + descriptor
# ---------------------------------------------------------------------------

def _is_ip_literal(value: str) -> bool:
    try:
        ipaddress.ip_address(value)
        return True
    except ValueError:
        return False


def _env_var(name: str) -> str:
    return f"{name.upper().replace('-', '_')}_TOR_SERVICE_HOSTS"


def render_compose_fragment(services: dict[str, list[str]], image: str, keys: str,
                            container: str, runtime: str = "docker") -> str:
    """Render the mergeable compose fragment for one or more services.

    `services` maps a service name to a list of ``onion_port:host:port``
    mappings. Output is deterministic (sorted); with one service it is identical
    to the previous single-service output.
    """
    env_lines = "".join(
        f'      {_env_var(n)}: "{",".join(v)}"\n' for n, v in sorted(services.items())
    )
    hosts = sorted({
        m.split(":")[1]
        for mappings in services.values() for m in mappings
        if len(m.split(":")) == 3
    } - {""})
    hosts = [h for h in hosts if CONTAINER_RE.fullmatch(h) and not _is_ip_literal(h)]
    dep_block = ("    depends_on:\n" + "".join(f"      - {h}\n" for h in hosts)
                 if hosts else "")
    apparmor = "      - apparmor=docker-default\n" if runtime == "docker" else ""
    # Podman rejects the Docker-only uid=/gid=/mode= tmpfs options (the entrypoint
    # chowns /var/lib/tor at startup instead), so only Docker gets them.
    tor_tmpfs = "- /var/lib/tor:rw,noexec,nosuid,nodev,size=64m"
    if runtime == "docker":
        tor_tmpfs += ",uid=100,gid=101,mode=0700"
    compose_cmd = "podman-compose" if runtime == "podman" else "docker compose"
    example = sorted(services)[0]
    header = (f"# hiddenforge compose fragment "
              f"(contract v{HIDDENFORGE_VERSION}, contract {CONTRACT_VERSION}).")
    # json.dumps produces a double-quoted scalar that YAML parses as one string,
    # so a path cannot open a new key (`privileged: true`) or a second volume.
    keys_mount = json.dumps(f"{keys}:/var/lib/tor/hidden_service")
    return f"""{header}
# Merge it into YOUR compose file; do not edit it:
#
#   {compose_cmd} -f compose.yml -f compose.service.yml up -d
#
# Your backend service must join the `tor-internal` network below and must NOT
# publish any ports. hiddenforge reaches it by service name; the resolved IP is
# pinned into the torrc at container start.
#
# Address:  hiddenforge show --json --name {example}
# Ready:    hiddenforge status --json   (poll the `ready` field)
#
# Threat model: state-level adversary. Do not weaken these flags.

networks:
  tor-internal:
    internal: true
  tor-external: {{}}

services:
  {container}:
    image: {image}
    restart: unless-stopped
    cap_drop: [ALL]
    cap_add: [CHOWN, DAC_OVERRIDE, FOWNER, SETUID, SETGID]
    security_opt:
      - no-new-privileges:true
{apparmor}    read_only: true
    pids_limit: 256
    mem_limit: 512m
    memswap_limit: 512m
    cpus: 1.0
    ulimits:
      nofile:
        soft: 8192
        hard: 8192
    tmpfs:
      - /tmp:rw,noexec,nosuid,nodev,size=64m
      - /etc/tor:rw,noexec,nosuid,nodev,size=8m
      {tor_tmpfs}
    logging:
      driver: none
    environment:
{env_lines}    volumes:
      - {keys_mount}
    networks:
      - tor-internal
      - tor-external
    healthcheck:
      test: ["CMD", "su-exec", "tor", "python3", "/usr/local/bin/healthcheck.py"]
      interval: 60s
      timeout: 10s
      start_period: 120s
      retries: 3
{dep_block}"""


def render_deploy_sh(services: dict[str, list[str]], keys_dir: str,
                     container: str, runtime: str = "docker") -> str:
    names = " ".join(shlex.quote(n) for n in sorted(services))
    # Quoted for the shell, not interpolated into one. deploy.sh is written 0755
    # and the README tells the operator to run it.
    keys_q = shlex.quote(keys_dir)
    # Inside an echo's double quotes: the same string with quote characters and
    # backslashes neutralised, so it reads back as itself.
    keys_dir_display = (keys_dir.replace("\\", "\\\\").replace('"', "'")
                        .replace("$", "\\$").replace("`", "'"))
    if runtime == "podman":
        engine_check = ("if ! command -v podman-compose >/dev/null 2>&1; then\n"
                        '    echo "podman-compose not installed." >&2\n'
                        "    exit 1\nfi")
        up = "podman-compose"
    else:
        engine_check = ("if ! command -v docker >/dev/null 2>&1; then\n"
                        '    echo "docker not installed. Install Docker Engine first." >&2\n'
                        "    exit 1\nfi")
        up = "docker compose"
    container_q = shlex.quote(container)
    return f"""#!/usr/bin/env bash
# hiddenforge, one-shot deploy. Generated by `hiddenforge setup`.
# Usage: ./deploy.sh [path/to/your-compose.yml]
set -euo pipefail
cd "$(dirname "$0")"

BASE="${{1:-compose.yml}}"
{engine_check}

echo "==> Preparing key directory {keys_dir_display}"
mkdir -p {keys_q}
chmod 700 {keys_q} 2>/dev/null || :

echo "==> Bringing the stack up"
{up} -f "$BASE" -f compose.service.yml up -d

echo "==> Waiting for the .onion address(es) (up to 180s each)"
for svc in {names}; do
    onion=""
    for _ in $(seq 1 180); do
        onion=$({up} -f "$BASE" -f compose.service.yml exec -T {container_q} \\
            su-exec tor cat /var/lib/tor/hidden_service/$svc/hostname 2>/dev/null || true)
        if [ -n "$onion" ]; then break; fi
        sleep 1
    done
    echo
    echo "================================================================="
    if [ -n "$onion" ]; then
        echo "$svc .onion: $onion"
        echo "Persisted to: {keys_dir_display}/$svc/hostname and {keys_dir_display}/$svc.onion"
    else
        echo "$svc: address not ready yet; check the container logs"
    fi
done
echo "BACK UP THE ENTIRE {keys_dir_display} DIRECTORY. It IS your address."
echo "================================================================="
"""


def render_readme_txt(services: dict[str, list[str]], image: str, keys_dir: str,
                      container: str, runtime: str = "docker") -> str:
    services_block = "\n".join(
        f'  {n}: {_env_var(n)}="{",".join(v)}"' for n, v in sorted(services.items())
    )
    names = ", ".join(sorted(services))
    compose_cmd = "podman-compose" if runtime == "podman" else "docker compose"
    # Every value inside a COMMAND line is shell-quoted: an operator copies these
    # lines into a terminal. The prose lines show the value as typed.
    keys_q = shlex.quote(keys_dir)
    return f"""hiddenforge, your setup
=========================

Services:
{services_block}
Image:     {image}
Keys:      {keys_dir}

How to bring it up
------------------
1. Make sure every backend service joins the `tor-internal` network and has no
   published ports.
2. ./deploy.sh   (or: {compose_cmd} -f compose.yml -f compose.service.yml up -d)

Where the addresses live
------------------------
  {keys_dir}/<service>/hostname   <- Tor's own hostname file
  {keys_dir}/<service>.onion      <- world-readable copy written at startup

Read one any time:
  hiddenforge show --keys {keys_q} --name <service> --json

Services: {names}

BACK UP THE ENTIRE {keys_dir} DIRECTORY. A key IS a .onion address.
Losing it loses that address permanently.

If you recreate a backend container, restart hiddenforge so it re-resolves the
backend IP:  {compose_cmd} restart {container}
"""


def _prompt(text: str, default: str | None = None) -> str:
    if not sys.stdin.isatty():
        raise EOFError(text)
    suffix = f" [{default}]" if default else ""
    val = input(f"{text}{suffix}: ").strip()
    if not val and default is not None:
        return default
    if not val:
        raise EOFError(text)
    return val


def _parse_backend(backend: str) -> tuple[str, str]:
    if ":" not in backend:
        raise ValueError(f"--backend must be host:port, got {backend!r}")
    host, _, port = backend.rpartition(":")
    if not host or not port.isdigit() or not (1 <= int(port) <= 65535):
        raise ValueError(f"--backend must be host:port with port 1-65535, got {backend!r}")
    if not re.fullmatch(r"[a-zA-Z0-9._\-]{1,253}", host):
        raise ValueError(f"invalid backend host {host!r}")
    return host, port


def _parse_service_spec(spec: str) -> tuple[str, str]:
    """Parse `name:onion_port:host:port` into (name, 'onion_port:host:port')."""
    parts = spec.split(":")
    if len(parts) != 4:
        raise ValueError(f"service mapping must be name:onionport:host:port, got {spec!r}")
    sname = validate_name(parts[0])
    onp, host, port = parts[1], parts[2], parts[3]
    if not onp.isdigit() or not (1 <= int(onp) <= 65535):
        raise ValueError(f"bad onion port in {spec!r}")
    if not port.isdigit() or not (1 <= int(port) <= 65535):
        raise ValueError(f"bad backend port in {spec!r}")
    if not re.fullmatch(r"[a-zA-Z0-9._\-]{1,253}", host):
        raise ValueError(f"invalid backend host in {spec!r}")
    return sname, f"{onp}:{host}:{port}"


def cmd_setup(args) -> int:
    try:
        services: dict[str, list[str]] = {}

        def add(sname: str, mapping: str) -> None:
            bucket = services.setdefault(sname, [])
            if mapping not in bucket:
                bucket.append(mapping)

        # Three ways in, all mergeable: --services (legacy comma list), --service
        # (repeatable), and --backend/--name (the simple single-service form).
        for spec in (args.services or "").split(","):
            if spec.strip():
                add(*_parse_service_spec(spec.strip()))
        for spec in (args.service or []):
            add(*_parse_service_spec(spec))
        if args.backend:
            host, port = _parse_backend(args.backend)
            add(validate_name(args.name or DEFAULT_NAME),
                f"{args.onion_port}:{host}:{port}")
        if not services:
            if args.non_interactive or args.json or not sys.stdin.isatty():
                raise ValueError("--backend service:port is required "
                                 "(or --service/--services)")
            host, port = _parse_backend(_prompt("Backend service:port (e.g. web:80)"))
            add(validate_name(args.name or DEFAULT_NAME),
                f"{args.onion_port}:{host}:{port}")

        out = Path(args.out)
        out.mkdir(parents=True, exist_ok=True)
        outputs = ("compose.service.yml", "deploy.sh", "README.txt", "hiddenforge.json")
        existing = [p for p in outputs if os.path.lexists(out / p)]
        if existing and not args.force:
            raise ValueError(f"{out} already contains {', '.join(existing)}; "
                             "pass --force to overwrite")
        # Checked for ALL four before writing ANY: a refusal part-way through
        # used to leave a new compose file beside the old deploy script.
        odd = [p for p in existing if not stat.S_ISREG(os.lstat(out / p).st_mode)]
        if odd:
            raise ValueError(f"refusing to replace {', '.join(odd)} in {out}: not a "
                             "regular file (a symlink, directory or FIFO is not "
                             "something setup wrote)")

        image = validate_image_ref(args.image)
        keys = validate_keys_dir(args.keys)
        # Every value that reaches the generated files is validated. --container
        # was the one that was not, and it becomes a YAML KEY in the fragment
        # (`  {container}:`) and an argument in deploy.sh. Reproduced before this
        # line existed: a crafted name put `privileged: true` on the tor service
        # and added a second service beside it. Docker's own naming rules are
        # narrower than CONTAINER_RE, so nothing legitimate is refused.
        container = validate_container(args.container)
        runtime = args.runtime
        if not 1 <= int(args.onion_port) <= 65535:
            raise ValueError(
                f"--onion-port must be 1-65535, got {args.onion_port}. Emitting it "
                "anyway would write a compose file whose service the container "
                "drops at boot, with the reason only in the container log.")
        _write_text_nofollow(
            out / "compose.service.yml",
            render_compose_fragment(services, image, keys, container, runtime))
        _write_text_nofollow(
            out / "deploy.sh",
            render_deploy_sh(services, keys, container, runtime), mode=0o755)
        _write_text_nofollow(
            out / "README.txt",
            render_readme_txt(services, image, keys, container, runtime))

        compose_cmd = "podman-compose" if runtime == "podman" else "docker compose"
        # `merge`/`bare_command` are commands, and docs/INTEGRATION.md offers the
        # descriptor to programs: quote the path so a consumer that hands the
        # string to a shell runs what it says. Same reason as deploy.sh.
        fragment_q = shlex.quote(f"{out}/compose.service.yml")
        merge_cmd = f"{compose_cmd} -f compose.yml -f {fragment_q} up -d"
        svc_list = [
            {
                "name": n,
                "env_var": _env_var(n),
                "env_value": ",".join(v),
                "address_command": f"hiddenforge show --json --name {n}",
                "address_file": f"{keys}/{n}.onion",
                "key_path": f"{keys}/{n}/{SECRET_FILE}",
            }
            for n, v in sorted(services.items())
        ]
        first = svc_list[0]
        descriptor = {
            "name": first["name"],
            "env_var": first["env_var"],
            "env_value": first["env_value"],
            "services": svc_list,
            "backend": services[first["name"]][0].split(":")[1],
            "image": image,
            "keys": keys,
            "container": container,
            "runtime": runtime,
            "onion_port": args.onion_port,
            "output_dir": str(out.resolve()),
            "merge": merge_cmd,
            "address_command": f"hiddenforge show --json --name {first['name']}",
            "ready_command": "hiddenforge status --json",
            "bare_command": merge_cmd,
            "address_file": first["address_file"],
            "key_path": first["key_path"],
            "contract_version": CONTRACT_VERSION,
            "hiddenforge_version": HIDDENFORGE_VERSION,
        }
        _write_text_nofollow(
            out / "hiddenforge.json",
            json.dumps(descriptor, indent=2, sort_keys=True) + "\n")

        if args.json:
            doc = {"ok": True, "exit_code": EXIT_OK, **descriptor}
            print(json.dumps(doc, indent=2, sort_keys=True))
            return EXIT_OK
        _narrate(args, f"Wrote {out}/compose.service.yml")
        _narrate(args, f"Wrote {out}/deploy.sh")
        _narrate(args, f"Wrote {out}/README.txt")
        _narrate(args, f"Wrote {out}/hiddenforge.json")
        _narrate(args, "")
        _narrate(args, "Next:")
        _narrate(args, "  1. Put each backend on the `tor-internal` network, with no ports.")
        _narrate(args, f"  2. {merge_cmd}")
        for n in sorted(services):
            _narrate(args, f"  3. hiddenforge show --json --name {n}")
        return EXIT_OK
    except (ValueError, EOFError, OSError) as exc:
        if isinstance(exc, EOFError):
            return emit_json(EXIT_ABORTED, error="aborted at prompt (no TTY)")
        if isinstance(exc, OSError):
            # The machine contract: one JSON document and a stable exit code,
            # never a traceback, whatever the filesystem does.
            return emit_json(EXIT_FAIL, error=str(exc))
        return emit_json(EXIT_USAGE, error=str(exc))


# ---------------------------------------------------------------------------
# vanity (host wrapper around the in-image generator)
# ---------------------------------------------------------------------------

def _rewrite_key_paths(doc: dict, keys: Path, container_prefix: str = "/keys/") -> dict:
    """Rewrite generator-reported container paths to host paths.

    The in-image generator reports /keys/...; the host consumer needs paths in
    its own key directory. Every path field must be rewritten - leaving one as a
    container path is silently wrong.
    """
    for field in ("key_path", "key_dir", "address_path", "public_key_path"):
        val = doc.get(field)
        if isinstance(val, str) and val.startswith(container_prefix):
            doc[field] = str(keys / val[len(container_prefix):])
    return doc


def cmd_vanity(args) -> int:
    try:
        validate_name(args.name)
        validate_image_ref(args.image)
        if not PREFIX_RE.fullmatch(args.prefix):
            raise ValueError(
                f"invalid prefix {args.prefix!r}: use base32 characters a-z and 2-7 "
                "(no 0,1,8,9), max 12")
    except ValueError as exc:
        return emit_json(EXIT_USAGE, error=str(exc))

    keys = Path(args.keys).resolve()
    try:
        validate_keys_dir(str(keys))
    except ValueError as exc:
        return emit_json(EXIT_USAGE, error=str(exc))
    if ":" in str(keys):
        # The path goes into `-v <path>:/keys`, and the engine splits that on
        # colons: the rest becomes a destination and mount options. It failed as
        # "invalid mode: /keys" from inside docker, exit 1, with no hint that
        # the path was the problem.
        return emit_json(EXIT_USAGE, keys=str(keys),
                         error=f"key directory {str(keys)!r} contains ':', which "
                               "the container engine cannot mount with -v; use a "
                               "path without one")
    keys.mkdir(parents=True, exist_ok=True)
    target = keys / args.name
    if (target.exists() or target.is_symlink()) and not args.force:
        return emit_json(EXIT_USAGE, name=args.name, key_dir=str(target),
                         error=f"{target} already exists; pass --force to archive it "
                               "and generate a new address")

    eng = _engine()
    if eng is None:
        return emit_json(EXIT_USAGE, error="neither docker nor podman found on PATH; "
                                           "vanity runs the generator inside the image")

    inner = ["vanity", "--prefix", args.prefix,
             "--name", args.name, "--out", "/keys", "--json"]
    if args.threads:
        inner += ["--threads", str(args.threads)]
    if args.bench:
        inner += ["--bench", "--seconds", str(args.seconds)]
    if args.force:
        inner += ["--force"]
    uid, gid = os.getuid(), os.getgid()
    inner += ["--uid", str(uid), "--gid", str(gid)]
    cmd = [eng, "run", "--rm", "-v", f"{keys}:/keys", args.image, *inner]
    # Unbounded by design: a vanity search may run for hours for a long prefix;
    # a timeout here would be the bug. (Contrast the _run() wrapper, which is
    # bounded because docker inspect/exec must not hang.)
    proc = subprocess.run(cmd, capture_output=True, text=True, check=False)
    out = proc.stdout.strip()
    if args.json:
        doc = None
        for line in reversed(out.splitlines()):
            try:
                doc = json.loads(line)
                break
            except json.JSONDecodeError:
                continue
        if doc is None:
            return emit_json(EXIT_FAIL, error=f"generator produced no JSON "
                             f"(rc={proc.returncode}): {proc.stderr.strip()[-400:]}")
        doc = _rewrite_key_paths(doc, keys)
        doc["image"] = args.image
        sys.stdout.write(json.dumps(doc, sort_keys=True) + "\n")
        return proc.returncode
    if out:
        print(out)
    if proc.stderr.strip():
        _eprint(proc.stderr.strip())
    return proc.returncode


# ---------------------------------------------------------------------------
# backup / restore / rotate / encrypt-key / decrypt-key
# ---------------------------------------------------------------------------

def _pick_tool(preferred: str | None, out_suffix: str = "",
               non_interactive: bool = False) -> str | None:
    if preferred:
        return preferred
    if out_suffix.endswith(".age") and shutil.which("age"):
        return "age"
    if out_suffix.endswith(".gpg") and shutil.which("gpg"):
        return "gpg"
    # age can only prompt for its passphrase on a TTY, so when we already have a
    # passphrase (or there is no TTY) gpg is the only usable default.
    if non_interactive:
        if shutil.which("gpg"):
            return "gpg"
        return "age" if shutil.which("age") else None
    for tool in ("age", "gpg"):
        if shutil.which(tool):
            return tool
    return None


def _non_interactive(args) -> bool:
    return bool(getattr(args, "passphrase_file", None)) or not sys.stdin.isatty()


def _passphrase(args) -> str | None:
    if getattr(args, "passphrase_file", None):
        data = Path(args.passphrase_file).read_bytes()
        if len(data) > 4096:
            raise ValueError("passphrase file too large")
        return data.decode("utf-8").rstrip("\r\n")
    return None


def _tar_keys(keys: Path, max_bytes: int = 512 * 1024 * 1024) -> bytes:
    """Deterministic tar of the key volume (regular files only, no symlinks)."""
    import io
    buf = io.BytesIO()
    with tarfile.open(fileobj=buf, mode="w", format=tarfile.PAX_FORMAT) as tar:
        total = 0
        count = 0
        for path in sorted(keys.rglob("*")):
            if path.is_symlink():
                continue
            if not path.is_file():
                continue
            rel = path.relative_to(keys)
            # Ask how big it is BEFORE reading it. The budget used to be checked
            # against len(data), which means a single oversized file was already
            # entirely in memory by the time the guard ran -- and this walks an
            # operator-supplied volume that the threat model allows to have been
            # restored from untrusted media. stat() first makes the limit a limit.
            total += path.stat().st_size
            count += 1
            if total > max_bytes:
                raise ValueError("key volume is unexpectedly large")
            # O_NOFOLLOW and a regular-file check on the descriptor: the
            # is_symlink() test above is a separate lookup, so a file replaced by
            # a symlink between the two would otherwise be read THROUGH it and
            # its target's bytes archived as key material. It now fails loudly.
            data = _read_nofollow(path, max_bytes)
            info = tarfile.TarInfo(name=str(rel))
            info.size = len(data)
            info.mtime = 0
            info.mode = 0o600
            info.uid = info.gid = 0
            info.uname = info.gname = ""
            tar.addfile(info, io.BytesIO(data))
        if count == 0:
            raise ValueError(f"no key files found under {keys}")
    return buf.getvalue()


def _tar_sha256(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def _encrypt_bytes(tool: str, plaintext: bytes, passphrase: str | None,
                   require_aead: bool = False) -> tuple[bytes, str]:
    """Encrypt and return ``(ciphertext, mode)``.

    ``mode`` is ``"aead"`` or ``"cfb"``. CFB+MDC is not AEAD: its integrity
    guarantee is weaker and its failure mode on a chosen-ciphertext attack is
    different, so receiving it silently is a downgrade the operator must see.
    ``require_aead`` turns the fallback into a hard error for production keys.
    """
    if tool == "openssl":
        raise ValueError("openssl is refused: it provides no authentication. Use age or gpg.")
    if tool == "age":
        # age -p prompts on the controlling TTY and cannot be fed a passphrase
        # non-interactively; the ciphertext comes back on stdout. age always uses
        # ChaCha20-Poly1305, so it is AEAD by construction.
        if passphrase is not None:
            raise ValueError("age does not use --passphrase-file; pass --tool gpg for "
                             "non-interactive use")
        if not sys.stdin.isatty():
            raise ValueError("age needs an interactive TTY to prompt for a passphrase; "
                             "pass --tool gpg for non-interactive use")
        # Unbounded by design: age prompts for the passphrase on the controlling
        # TTY, so it blocks until the operator types; a timeout would abort them.
        proc = subprocess.run(["age", "-p"], input=plaintext, stdout=subprocess.PIPE,
                              check=False)
        if proc.returncode != 0:
            raise RuntimeError("age failed")
        return proc.stdout, "aead"
    if tool == "gpg":
        if passphrase is None:
            raise ValueError("gpg needs --passphrase-file for non-interactive use")
        last_err = ""
        # Prefer an AEAD cipher (OCB). Fall back to the default (CFB + MDC) only
        # when the local gpg is too old to know --force-aead.
        for aead in (["--force-aead"], []):
            pass_fd, write_fd = os.pipe()
            try:
                # Safe to write before gpg exists to read it only because
                # _passphrase() caps the file at 4096 bytes, far below a pipe's
                # 64 KiB capacity. Raise that cap and this blocks for ever.
                os.write(write_fd, passphrase.encode())
                os.close(write_fd)
                proc = subprocess.run(
                    ["gpg", "--symmetric", "--batch", "--yes", "--cipher-algo", "AES256",
                     *aead, "--pinentry-mode", "loopback", "--passphrase-fd", str(pass_fd)],
                    input=plaintext, capture_output=True, pass_fds=(pass_fd,), check=False,
                    timeout=600)
            finally:
                with contextlib.suppress(OSError):
                    os.close(pass_fd)
            if proc.returncode == 0:
                if aead:
                    return proc.stdout, "aead"
                if require_aead:
                    raise ValueError(
                        "--require-aead: this gpg refused --force-aead, so the backup "
                        "would be CFB+MDC, not AEAD. Refusing to write it. Upgrade gpg "
                        "or drop --require-aead deliberately.")
                _eprint("WARNING: this gpg does not support --force-aead; the backup is "
                        "CFB+MDC, NOT AEAD. Its integrity guarantee is weaker. "
                        "Pass --require-aead to refuse this, or upgrade gpg.")
                return proc.stdout, "cfb"
            last_err = proc.stderr.decode(errors="replace").strip()
            low = last_err.lower()
            if aead and ("invalid option" in low or "unknown option" in low):
                continue
            break
        raise RuntimeError(f"gpg failed: {last_err}")
    raise ValueError(f"unknown tool {tool!r}")


def _gpg_cipher_mode(tool: str, ciphertext: bytes, passphrase: str | None) -> str | None:
    """Best-effort: report whether a gpg backup is AEAD or CFB, for restore.

    The cipher is recorded in the file's packet header, so this needs the
    passphrase only to decrypt the session key. Returns None if it cannot tell --
    the caller then says nothing rather than guessing.
    """
    if tool != "gpg" or passphrase is None:
        return None
    pass_fd, write_fd = os.pipe()
    try:
        os.write(write_fd, passphrase.encode())
        os.close(write_fd)
        proc = subprocess.run(
            ["gpg", "--list-packets", "--batch", "--pinentry-mode", "loopback",
             "--passphrase-fd", str(pass_fd)],
            input=ciphertext, capture_output=True, pass_fds=(pass_fd,), check=False,
            timeout=60)
    finally:
        with contextlib.suppress(OSError):
            os.close(pass_fd)
    text = (proc.stdout + proc.stderr).decode(errors="replace").lower()
    if "aead" in text:
        return "aead"
    if "cipher" in text:
        return "cfb"
    return None


def cmd_backup(args) -> int:
    try:
        keys = Path(args.keys)
        if not keys.is_dir():
            raise ValueError(f"key directory {keys} does not exist")
        tool = _pick_tool(args.tool, args.out, _non_interactive(args))
        if tool is None:
            raise ValueError(_no_tool_error())
        if tool == "openssl":
            raise ValueError("openssl is refused for backup creation (no authentication)")
        passphrase = _passphrase(args)
        if passphrase is None and not sys.stdin.isatty():
            if tool == "age":
                raise ValueError(
                    "age prompts for its passphrase on a TTY and cannot run "
                    "unattended; use --tool gpg with --passphrase-file instead")
            raise ValueError("no passphrase source: pass --passphrase-file (or a TTY)")
        plaintext = _tar_keys(keys)
        if not plaintext:
            raise ValueError("key directory is empty; nothing to back up")
        src_sha = _tar_sha256(plaintext)
        ciphertext, cipher_mode = _encrypt_bytes(
            tool, plaintext, passphrase, require_aead=getattr(args, "require_aead", False))
        out = Path(args.out)
        fd = os.open(out, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
        with os.fdopen(fd, "wb") as fh:
            fh.write(ciphertext)
        if args.json:
            return emit_json(EXIT_OK, out=str(out), tool=tool, cipher_mode=cipher_mode,
                             bytes=len(ciphertext), sha256=src_sha)
        print(f"Wrote {out} ({len(ciphertext):,} bytes, {tool}/{cipher_mode}, mode 0600)")
        print(f"Plaintext manifest sha256: {src_sha}")
        return EXIT_OK
    except (ValueError, OSError, RuntimeError) as exc:
        return emit_json(EXIT_USAGE if isinstance(exc, ValueError) else EXIT_FAIL,
                         error=str(exc))


def _decrypt_bytes(tool: str, ciphertext: bytes, passphrase: str | None) -> bytes:
    if tool == "age":
        if not sys.stdin.isatty():
            raise ValueError("age needs an interactive TTY to prompt for a passphrase; "
                             "use gpg for non-interactive restores")
        # Unbounded by design: age's passphrase prompt blocks on the controlling
        # TTY until the operator types.
        proc = subprocess.run(["age", "-d"], input=ciphertext, stdout=subprocess.PIPE,
                              check=False)
        if proc.returncode != 0:
            raise RuntimeError("age decrypt failed")
        return proc.stdout
    if tool == "openssl":
        raise ValueError("openssl decryption is not supported; use gpg or age")
    if tool == "gpg":
        if passphrase is None:
            raise ValueError("gpg needs --passphrase-file")
        pass_fd, write_fd = os.pipe()
        try:
            os.write(write_fd, passphrase.encode())
            os.close(write_fd)
            proc = subprocess.run(
                ["gpg", "--decrypt", "--batch", "--yes", "--pinentry-mode", "loopback",
                 "--passphrase-fd", str(pass_fd)],
                input=ciphertext, capture_output=True, pass_fds=(pass_fd,), check=False,
                timeout=600)
        finally:
            with contextlib.suppress(OSError):
                os.close(pass_fd)
        if proc.returncode != 0:
            detail = proc.stderr.decode(errors="replace").strip()
            raise RuntimeError(f"gpg decrypt failed: {detail}")
        return proc.stdout
    raise ValueError(f"unknown tool {tool!r}")


def _dir_fd_under(root_fd: int, parts, cache: dict, create: bool = True) -> int | None:
    """A descriptor for ``parts`` beneath ``root_fd``, creating as needed.

    Every component is opened O_NOFOLLOW|O_DIRECTORY relative to the previous
    descriptor, so a symlink anywhere in the chain raises instead of being
    followed. The caller owns nothing: the descriptors live in ``cache`` and are
    closed by ``_close_dir_fds``. With ``create=False`` nothing is made, and a
    missing component returns None: that is how the conflict scan looks without
    leaving directories behind for an archive it goes on to refuse.

    This exists because refusing absolute paths and ".." in the ARCHIVE is not
    enough. The traversal that matters is in the DESTINATION: a key volume that
    already contains `app -> /etc` turns a member named `app/hs_ed25519_secret_key`
    -- absolute-free, ".."-free, and accepted by every check above -- into a write
    to /etc. Reproduced before this was written: the file landed outside the
    volume, and the operator was left with a key directory Tor would regenerate
    from scratch. The key volume is operator-supplied and the threat model allows
    it to have been restored from untrusted media, so a planted link is in scope.
    """
    key = tuple(parts)
    if not key:
        return root_fd            # a member at the top of the volume
    if key in cache:
        return cache[key]
    parent_fd = _dir_fd_under(root_fd, key[:-1], cache, create)
    if parent_fd is None:
        return None
    name = key[-1]
    if create:
        with contextlib.suppress(FileExistsError):
            os.mkdir(name, 0o700, dir_fd=parent_fd)
    try:
        fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=parent_fd)
    except FileNotFoundError:
        if create:
            raise
        return None
    cache[key] = fd
    return fd


def _close_dir_fds(cache: dict) -> None:
    for fd in cache.values():
        with contextlib.suppress(OSError):
            os.close(fd)


def _check_archive_members(tar, members, accept_envelope: bool) -> None:
    """Refuse a whole archive, before anything touches the disk, if any member is unsafe.

    Shared by `restore` and `decrypt-key`, which used to carry two copies of this
    logic and had already drifted: decrypt-key silently SKIPPED members restore
    refused, never checked names for control characters, and accepted an archive
    with no key in it at all.

    Refused: anything that is not a regular file or a directory (links, devices,
    FIFOs); absolute names and ".." components; control characters in a name --
    these names become directories in the key volume and are printed back by
    `show`, `status` and `doctor`, where a newline splits a line and an escape
    sequence rewrites the terminal. And an archive that carries no identity:
    reporting success over an empty volume is the worst answer a restore can
    give, because the operator believes the key is back.

    A member merely NAMED like a secret key is not one. Every
    `hs_ed25519_secret_key` must be exactly the 96 bytes Tor writes and start
    with Tor's tag: a truncated or empty one used to count as "an identity",
    and with --force that moved the real key aside and installed the empty one.
    """
    has_identity = False
    seen_files: set[tuple[str, ...]] = set()
    for m in members:
        if not (m.isfile() or m.isdir()):
            raise ValueError(f"refusing unsafe archive member {m.name!r}")
        name = Path(m.name)
        if name.is_absolute() or ".." in name.parts:
            raise ValueError(f"refusing unsafe archive path {m.name!r}")
        bad = [c for c in m.name if ord(c) < 0x20 or ord(c) == 0x7F]
        if bad:
            raise ValueError(
                f"refusing archive member with a control character "
                f"({bad[0]!r}) in its name: {m.name!r}")
        if m.isfile() and not name.parts:
            raise ValueError(f"refusing archive member with an empty name {m.name!r}")
        if m.isfile():
            # tar allows a name twice (the last one wins on extraction); for key
            # material that is an ambiguity, not a feature, and it would collide
            # with the O_EXCL write below.
            if name.parts in seen_files:
                raise ValueError(f"refusing archive with a duplicate member {m.name!r}")
            seen_files.add(name.parts)
        # Either a plaintext key, or (for a whole-volume restore) the envelope
        # `encrypt-key` leaves behind: a volume whose keys were encrypted with
        # --delete-plaintext has no SECRET_FILE in it, and refusing to restore
        # THAT backup would be a worse bug than the one this check exists to stop.
        if m.isfile() and name.name == SECRET_FILE:
            fh = tar.extractfile(m)
            head = fh.read(TAG_LEN) if fh is not None else b""
            if m.size != SECRET_KEY_FILE_LEN or not head.startswith(SECRET_TAG):
                raise ValueError(
                    f"refusing archive member {m.name!r}: it is named like a Tor "
                    f"secret key but is {m.size} bytes"
                    + ("" if head.startswith(SECRET_TAG) else " without Tor's key tag")
                    + f", not the {SECRET_KEY_FILE_LEN}-byte key Tor writes. The "
                      "archive is truncated or is not a hiddenforge backup.")
            has_identity = True
        elif m.isfile() and accept_envelope and ".keys.tar." in name.name:
            has_identity = True
    if not has_identity:
        raise ValueError(
            f"this archive contains no {SECRET_FILE}"
            + (" and no encrypted key envelope" if accept_envelope else "")
            + ", so there is no identity in it to restore. Check that the input "
              "is a hiddenforge archive and that it is not truncated.")


def _extract_files(tar, members, root_fd: int, dir_fds: dict) -> None:
    """Write every regular-file member beneath ``root_fd``, descriptor-relative.

    Modes are set on descriptors, never on paths: each file 0600 regardless of
    what the archive declares (a crafted archive must not leave a secret key
    world-readable, and fchmod means the caller's umask cannot move it either),
    and each directory written into 0700. Nothing else in the volume is touched.
    The previous version finished with a path-based chmod over EVERY entry in the
    volume, which re-resolved names it had just refused to follow, and reset the
    published `<name>.onion` files from 0644 to 0600, so a host consumer that
    reads the address from the mount lost it after any restore.
    """
    for m in members:
        if not m.isfile():
            continue
        src_fh = tar.extractfile(m)
        if src_fh is None:
            continue
        parts = Path(m.name).parts
        parent_fd = _dir_fd_under(root_fd, parts[:-1], dir_fds)
        # O_EXCL: by now every target is known to be absent (the conflict scan
        # refused or moved each existing one aside), so anything found at the
        # name was planted since -- and O_TRUNC would write key material through
        # it if it were a hardlink to a file outside the volume.
        fd = os.open(parts[-1], os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                     0o600, dir_fd=parent_fd)
        with os.fdopen(fd, "wb") as fh:
            os.fchmod(fh.fileno(), 0o600)
            fh.write(src_fh.read())
    for fd in dir_fds.values():
        if stat.S_IMODE(os.fstat(fd).st_mode) != 0o700:
            os.fchmod(fd, 0o700)


def _drop_stale_published(keys: Path, names) -> list[str]:
    """Remove `<keys>/<name>.onion` for services whose key was just replaced.

    That file is the container's published copy of the address, and after a
    restore or decrypt it may describe the key that was replaced. `show` falls
    back to it when `hostname` is unreadable from the host, which it usually is
    (the service directory is tor-owned 0700), so a stale copy would be reported
    as the address with `ok: true`. Removing it is always safe: the container
    rewrites it from the key once the service is reachable, and until then
    `show` says "not ready" rather than naming the old address.

    Returns the files that could not be removed, so the caller can say so.
    """
    left: list[str] = []
    try:
        root_fd = os.open(keys, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    except OSError:
        return [str(keys / f"{n}.onion") for n in names]
    try:
        for n in names:
            try:
                os.unlink(f"{n}.onion", dir_fd=root_fd)
            except FileNotFoundError:
                continue
            except OSError as exc:
                left.append(str(keys / f"{n}.onion"))
                _eprint(f"warning: could not remove the stale published address "
                        f"{keys / f'{n}.onion'}: {exc.strerror}. It may name the "
                        "key that was replaced; delete it by hand.")
    finally:
        os.close(root_fd)
    return left


def cmd_restore(args) -> int:
    try:
        src = Path(args.input)
        if not src.is_file():
            raise ValueError(f"backup {src} does not exist")
        tool = args.tool or ("age" if src.name.endswith(".age") else
                             "gpg" if src.name.endswith(".gpg") else None)
        if tool is None:
            raise ValueError("cannot infer --tool from the input name; pass --tool")
        passphrase = _passphrase(args)
        if passphrase is None and not sys.stdin.isatty():
            if tool == "age":
                raise ValueError(
                    "age prompts for its passphrase on a TTY and cannot run "
                    "unattended; use --tool gpg with --passphrase-file instead")
            raise ValueError("no passphrase source: pass --passphrase-file (or a TTY)")
        ciphertext_bytes = src.read_bytes()
        cipher_mode = _gpg_cipher_mode(tool, ciphertext_bytes, passphrase)
        plaintext = _decrypt_bytes(tool, ciphertext_bytes, passphrase)
        import io
        with tarfile.open(fileobj=io.BytesIO(plaintext), mode="r") as tar:
            members = tar.getmembers()
            # Every member is judged before the destination is touched, so a
            # refused archive leaves the volume exactly as it was found.
            _check_archive_members(tar, members, accept_envelope=True)
            keys = Path(args.keys)
            keys.mkdir(parents=True, exist_ok=True)
            # Every write below is made relative to this descriptor, never by
            # path, so no component of the destination can be a symlink we follow.
            root_fd = os.open(keys, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            dir_fds: dict = {}
            archived = None
            try:
                conflicts: list[str] = []
                for m in members:
                    if not m.isfile():
                        continue
                    parts = Path(m.name).parts
                    parent_fd = _dir_fd_under(root_fd, parts[:-1], dir_fds, create=False)
                    if parent_fd is None:
                        continue
                    try:
                        os.stat(parts[-1], dir_fd=parent_fd, follow_symlinks=False)
                    except FileNotFoundError:
                        continue
                    conflicts.append(str(Path(m.name)))
                if conflicts and not args.force:
                    return emit_json(EXIT_FAIL, input=str(src), keys=str(keys),
                                     tool=tool, conflicts=conflicts,
                                     error="refusing to overwrite existing key files; "
                                           "pass --force")
                if conflicts:
                    # Unique archive dir, and create the parent of each nested
                    # conflict: key files live under <name>/, so archiving
                    # "app/hs_ed25519_secret_key" needs .replaced-<t>/app to exist.
                    archived = _unique_dir(keys, ".replaced")
                    archived.mkdir(mode=0o700)
                    archive_fds: dict = {}
                    archive_fd = os.open(archived, os.O_RDONLY | os.O_DIRECTORY
                                         | os.O_NOFOLLOW)
                    try:
                        for c in conflicts:
                            parts = Path(c).parts
                            from_fd = _dir_fd_under(root_fd, parts[:-1], dir_fds)
                            to_fd = _dir_fd_under(archive_fd, parts[:-1], archive_fds)
                            os.rename(parts[-1], parts[-1],
                                      src_dir_fd=from_fd, dst_dir_fd=to_fd)
                    finally:
                        _close_dir_fds(archive_fds)
                        with contextlib.suppress(OSError):
                            os.close(archive_fd)
                _extract_files(tar, members, root_fd, dir_fds)
            finally:
                _close_dir_fds(dir_fds)
                with contextlib.suppress(OSError):
                    os.close(root_fd)
            restored = sorted({Path(m.name).parts[0] for m in members
                               if m.isfile() and len(Path(m.name).parts) == 2
                               and Path(m.name).name == SECRET_FILE})
        stale = _drop_stale_published(keys, restored)
        if args.json:
            return emit_json(EXIT_OK, input=str(src), keys=str(keys), tool=tool,
                             cipher_mode=cipher_mode,
                             archived=str(archived) if archived else None,
                             stale_address_files=stale)
        print(f"Restored {src} into {keys}"
              + (f" (decrypted an {cipher_mode.upper()} backup)" if cipher_mode else ""))
        return EXIT_OK
    except (ValueError, OSError, RuntimeError, tarfile.TarError) as exc:
        return emit_json(EXIT_USAGE if isinstance(exc, ValueError) else EXIT_FAIL,
                         error=str(exc))


def _unique_dir(base: Path, suffix: str) -> Path:
    """A non-existent sibling path ``<base><suffix>-<epoch>[-n]>``."""
    candidate = Path(f"{base}{suffix}-{int(time.time())}")
    n = 1
    while candidate.exists():
        candidate = Path(f"{base}{suffix}-{int(time.time())}-{n}")
        n += 1
    return candidate


ROTATED_PREFIX = ".rotated-"


def _rotate_inside(keys: Path) -> tuple[Path, list[str]]:
    """Archive the volume's CONTENTS into `<keys>/.rotated-<epoch>/`.

    For a key volume that is a mount point -- always the case for the image's own
    `rotate`, whose volume is the bind mount -- renaming the directory fails with
    EBUSY, so the old code could never rotate from inside the container at all.
    Moving the entries instead keeps the old identity recoverable in the same
    volume; Tor never looks at it, because only configured service names are
    HiddenServiceDirs and no service name can start with a dot.

    Every entry is checked before any is moved: a directory can only be moved to
    a new parent by a user who may write to it, so a volume half of which cannot
    be moved is refused whole rather than left half-rotated.
    """
    root_fd = os.open(keys, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        entries = sorted(n for n in os.listdir(root_fd)
                         if not n.startswith(ROTATED_PREFIX))
        if not entries:
            raise ValueError(f"{keys} holds no identity to rotate")
        stuck = [n for n in entries
                 if stat.S_ISDIR(os.stat(n, dir_fd=root_fd, follow_symlinks=False).st_mode)
                 and not os.access(n, os.W_OK, dir_fd=root_fd, follow_symlinks=False)]
        if stuck:
            raise OSError(errno.EACCES,
                          f"cannot move {', '.join(stuck)} (not writable by this user); "
                          "nothing was rotated. Run rotate where the service "
                          "directories are writable, e.g. inside the container")
        base = f"{ROTATED_PREFIX}{int(time.time())}"
        name, n = base, 1
        while True:
            try:
                os.mkdir(name, 0o700, dir_fd=root_fd)
                break
            except FileExistsError:
                name, n = f"{base}-{n}", n + 1
        archive_fd = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW,
                             dir_fd=root_fd)
        try:
            # Owned like the volume it sits in. Made by the container's root, a
            # 0700 archive was unreadable to the host user who owns the volume:
            # measured, the old identity was kept but could not be opened
            # without sudo. The entries moved into it keep their own owners.
            vol = os.fstat(root_fd)
            if os.geteuid() == 0 and os.fstat(archive_fd).st_uid != vol.st_uid:
                os.fchown(archive_fd, vol.st_uid, vol.st_gid)
            for entry in entries:
                os.rename(entry, entry, src_dir_fd=root_fd, dst_dir_fd=archive_fd)
        finally:
            os.close(archive_fd)
    finally:
        os.close(root_fd)
    return keys / name, entries


def cmd_rotate(args) -> int:
    try:
        keys = Path(args.keys)
        if not keys.is_dir():
            return emit_json(EXIT_USAGE, keys=str(keys),
                             error=f"key directory {keys} does not exist")
        if (args.confirm or "").strip() != "ROTATE":
            return emit_json(EXIT_USAGE, keys=str(keys),
                             error="refusing to destroy an identity without --confirm ROTATE")
        if os.path.ismount(keys):
            archived, moved = _rotate_inside(keys)
        else:
            if not os.access(keys, os.W_OK):
                return emit_json(EXIT_FAIL, keys=str(keys),
                                 error="key directory is not writable")
            archived = _unique_dir(keys, ".rotated")
            os.rename(keys, archived)
            keys.mkdir(mode=0o700)
            moved = None
        note = ("A running container keeps serving the old address from memory "
                "until it is restarted; restart it to generate the new one.")
        if args.json:
            return emit_json(EXIT_OK, keys=str(keys), archived=str(archived),
                             moved=moved, note=note)
        print(f"Moved the old identity to {archived}")
        print(f"{keys} is empty of identities now. {note}")
        return EXIT_OK
    except ValueError as exc:
        return emit_json(EXIT_USAGE, keys=str(getattr(args, "keys", "")), error=str(exc))
    except OSError as exc:
        return emit_json(EXIT_FAIL, error=str(exc))


def cmd_encrypt_key(args) -> int:
    # Offline at-rest encryption of a service key directory, using the same
    # age/gpg machinery as backup. HiddenForge does not decrypt at boot (Tor
    # needs the plaintext key in HiddenServiceDir); see docs/INTEGRATION.md.
    return _encrypt_or_decrypt_dir(args, encrypt=True)


def cmd_decrypt_key(args) -> int:
    return _encrypt_or_decrypt_dir(args, encrypt=False)


def _encrypt_or_decrypt_dir(args, encrypt: bool) -> int:
    """Wrap one service key directory in an authenticated, passphrase-protected
    encrypted tar (age or gpg), or restore it. Offline only: HiddenForge does not
    decrypt at boot, because Tor needs the plaintext secret key in
    HiddenServiceDir (the mount), so runtime at-rest encryption would be theatre.
    """
    try:
        keys = Path(args.keys)
        name = validate_name(args.name)
        d = keys / name
        tool = _pick_tool(args.tool, "", _non_interactive(args))
        if tool is None:
            raise ValueError(_no_tool_error())
        if tool == "openssl":
            raise ValueError("openssl is refused (no authentication)")
        passphrase = _passphrase(args)
        if passphrase is None and not sys.stdin.isatty():
            if tool == "age":
                raise ValueError(
                    "age prompts for its passphrase on a TTY and cannot run "
                    "unattended; use --tool gpg with --passphrase-file instead")
            raise ValueError("no passphrase source: pass --passphrase-file (or a TTY)")
        ext = "gpg" if tool == "gpg" else "age"
        blob = keys / f"{name}.keys.tar.{ext}"

        if encrypt:
            if not d.is_dir():
                raise ValueError(f"{d} does not exist")
            if blob.exists() and not args.force:
                raise ValueError(f"{blob} exists; pass --force to overwrite")
            plaintext = _tar_keys(d)
            ciphertext, cipher_mode = _encrypt_bytes(
                tool, plaintext, passphrase,
                require_aead=getattr(args, "require_aead", False))
            fd = os.open(blob, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "wb") as fh:
                os.fchmod(fh.fileno(), 0o600)
                fh.write(ciphertext)
                fh.flush()
                os.fsync(fh.fileno())
            if args.delete_plaintext:
                # Read the file back and decrypt it BEFORE destroying the only
                # copy. The key IS the .onion address: losing it loses the
                # address permanently and there is no recovery. "gpg exited 0"
                # is not evidence that what reached the disk can be decrypted --
                # a full filesystem, a truncated write, or a passphrase file
                # with a byte the operator did not mean to include all produce
                # an exit status of zero and a blob that never opens again.
                if tool != "gpg" or passphrase is None:
                    raise ValueError(
                        "--delete-plaintext refuses to run without a way to verify "
                        "the archive first: age decrypts only from a TTY, so the "
                        "check cannot be made non-interactively. Use --tool gpg "
                        "with --passphrase-file, or decrypt and remove the "
                        "plaintext yourself once you have confirmed the archive "
                        "opens.")
                recovered = _decrypt_bytes(tool, blob.read_bytes(), passphrase)
                if _tar_sha256(recovered) != _tar_sha256(plaintext):
                    raise RuntimeError(
                        f"{blob} did not decrypt back to the key material it was "
                        "made from; the plaintext has NOT been removed. Delete the "
                        "archive and try again.")
                shutil.rmtree(d)
            if args.json:
                return emit_json(EXIT_OK, name=name, archive=str(blob), tool=tool,
                                 cipher_mode=cipher_mode,
                                 bytes=len(ciphertext),
                                 deleted_plaintext=bool(args.delete_plaintext))
            print(f"Wrote {blob} ({len(ciphertext):,} bytes, {tool}/{cipher_mode}, mode 0600)")
            if args.delete_plaintext:
                print(f"Removed plaintext {d}")
            return EXIT_OK

        # decrypt
        if not blob.is_file():
            raise ValueError(f"{blob} does not exist")
        import io
        plaintext = _decrypt_bytes(tool, blob.read_bytes(), passphrase)
        with tarfile.open(fileobj=io.BytesIO(plaintext), mode="r") as tar:
            members = tar.getmembers()
            _check_archive_members(tar, members, accept_envelope=False)
            # Never write into an existing key set. The key IS the address: this
            # used to extract straight over whatever was in <keys>/<name>/, with
            # no --force and no copy kept, so decrypting an old envelope after the
            # service had a new key destroyed the live identity for good. And it
            # overwrote file by file, so a key set with a file the archive lacked
            # came out mixed. Now an existing, non-empty directory is refused, or
            # with --force moved aside whole, and the archive extracts into a
            # fresh one. Same rule as `restore --force` and `vanity --force`.
            if d.is_symlink() or (d.exists() and not d.is_dir()):
                raise ValueError(f"{d} exists and is not a directory; refusing")
            archived = None
            if d.is_dir() and any(d.iterdir()):
                if not args.force:
                    return emit_json(
                        EXIT_FAIL, name=name, key_dir=str(d),
                        error=f"{d} already holds a key set; refusing to overwrite "
                              "it. Pass --force to move it aside to "
                              f"{d.name}.replaced-<time> and decrypt into a fresh "
                              "directory.")
                archived = _unique_dir(d, ".replaced")
                os.rename(d, archived)
            d.mkdir(parents=True, exist_ok=True, mode=0o700)
            # Descriptor-relative, for the same reason cmd_restore is: the
            # traversal that matters is a symlinked directory in the destination.
            root_fd = os.open(d, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
            dir_fds: dict = {(): root_fd}
            try:
                _extract_files(tar, members, root_fd, dir_fds)
            finally:
                dir_fds.pop((), None)
                _close_dir_fds(dir_fds)
                with contextlib.suppress(OSError):
                    os.close(root_fd)
        stale = _drop_stale_published(keys, [name])
        if args.json:
            return emit_json(EXIT_OK, name=name, key_dir=str(d), tool=tool,
                             archived=str(archived) if archived else None,
                             stale_address_files=stale)
        print(f"Restored {d}" + (f" (previous key set moved to {archived})"
                                 if archived else ""))
        return EXIT_OK
    except (ValueError, OSError, RuntimeError, tarfile.TarError) as exc:
        return emit_json(EXIT_USAGE if isinstance(exc, ValueError) else EXIT_FAIL,
                         error=str(exc))


# ---------------------------------------------------------------------------
# verify-image / sbom (supply chain)
# ---------------------------------------------------------------------------

def _resolve_registry_digest(image: str) -> tuple[str | None, str | None]:
    """Registry digest for an image reference, via skopeo (no pull needed)."""
    if shutil.which("skopeo") is None:
        return None, "skopeo not found on PATH"
    proc = _run(["skopeo", "inspect", "--format", "{{.Digest}}", f"docker://{image}"])
    if proc.returncode != 0:
        return None, (proc.stderr.strip() or "skopeo failed")
    return proc.stdout.strip(), None


def _verify_ssh_signature(sigdir: Path, identity: str, digest_bytes: bytes,
                          allowed_signers: str) -> tuple[bool | None, str]:
    """Verify the SSH-FIDO2 signature against `allowed_signers`, never the sigdir's.

    `allowed_signers` is the trust anchor (PINNED_ALLOWED_SIGNERS unless the
    operator named one explicitly). A `<sigdir>/allowed-signers` file is ignored:
    trusting keys that arrive beside the signature they vouch for is no check.
    """
    sig = sigdir / "hiddenforge.digest.sig"
    if not sig.is_file():
        return None, "hiddenforge.digest.sig missing"
    if shutil.which("ssh-keygen") is None:
        return None, "ssh-keygen not found"
    with tempfile.TemporaryDirectory(prefix="hf-verify-") as tmp:
        allowed = Path(tmp) / "allowed-signers"
        _write_text_nofollow(allowed, allowed_signers, 0o600)
        proc = subprocess.run(
            ["ssh-keygen", "-Y", "verify", "-f", str(allowed), "-I", identity,
             "-n", "file", "-s", str(sig)],
            input=digest_bytes, capture_output=True, timeout=60, check=False)
    detail = (proc.stderr or proc.stdout).decode(errors="replace").strip()
    return proc.returncode == 0, detail


def _verify_mldsa_signature(sigdir: Path, digest_bytes: bytes,
                            trusted_pub: bytes | None = None
                            ) -> tuple[bool | None, str]:
    """(verdict, detail). False means it failed; None means it was NOT CHECKED.

    The distinction is the whole point. This is one half of a hybrid scheme --
    ML-DSA-65 alongside the SSH-FIDO2 signature -- and a verifier that treats a
    missing half as "nothing to report" lets an attacker turn a hybrid signature
    into a single classical one by deleting files, while the tool still prints
    VERIFIED. So a signature present without its public key (or the reverse) is a
    FAILURE: the signature set has been altered. A set with no post-quantum half,
    or a machine without the verifier, is "not checked", and cmd_verify_image
    refuses that unless the operator explicitly accepts a classical-only result.

    The public key is the trust anchor, so it is not taken on the signature
    set's word: either the operator supplies it (`trusted_pub`), or the set's copy
    must hash to PINNED_MLDSA_PUB_SHA256. Both the key and the digest are handed
    to pqsign from bytes read once, so nothing can be swapped between the check
    and the use.
    """
    pub = sigdir / "sambent-mldsa.pub"
    sig = sigdir / "hiddenforge.digest.mldsa"
    if trusted_pub is None and pub.is_file() != sig.is_file():
        missing = "public key" if sig.is_file() else "signature"
        return False, (f"the ML-DSA {missing} is missing while the other half is "
                       "present; this signature set has been altered")
    if not sig.is_file():
        return None, "this signature set carries no ML-DSA signature"
    if trusted_pub is None:
        try:
            pub_bytes = _read_nofollow(pub, 16384)
        except OSError as exc:
            return False, f"cannot read the ML-DSA public key: {exc}"
        if hashlib.sha256(pub_bytes).hexdigest() != PINNED_MLDSA_PUB_SHA256:
            return False, ("the ML-DSA public key in this signature set is not the "
                           "pinned release key; this signature set has been altered")
    else:
        pub_bytes = trusted_pub
    if shutil.which("pqsign") is None:
        return None, "pqsign not installed, so the ML-DSA signature was NOT checked"
    with tempfile.TemporaryDirectory(prefix="hf-verify-") as tmp:
        pub_tmp, dig_tmp = Path(tmp) / "mldsa.pub", Path(tmp) / "digest"
        for path, data in ((pub_tmp, pub_bytes), (dig_tmp, digest_bytes)):
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
            with os.fdopen(fd, "wb") as fh:
                fh.write(data)
        proc = _run(["pqsign", "verify", "--pub", str(pub_tmp), "--sig", str(sig),
                     "--in", str(dig_tmp)])
    return proc.returncode == 0, (proc.stderr.strip() or proc.stdout.strip())


def cmd_verify_image(args) -> int:
    try:
        image = validate_image_ref(args.image or build_manifest()["image"])
        sigdir = Path(args.sigdir)
        digest_file = sigdir / SIGNED_DIGEST_FILE
        if not digest_file.is_file():
            raise ValueError(f"{digest_file} not found; is --sigdir correct?")
        # Read ONCE. The registry comparison, the SSH check and the ML-DSA check
        # all used to read this file separately, so a writer to the signature
        # directory could show each of them a different digest.
        try:
            digest_bytes = _read_nofollow(digest_file, 4096)
        except OSError as exc:
            raise ValueError(f"cannot read {digest_file}: {exc}") from exc
        signed = digest_bytes.decode("ascii", "replace").strip()
        if not re.fullmatch(r"sha256:[0-9a-f]{64}", signed):
            raise ValueError(f"{digest_file} does not contain a sha256 digest")

        # The trust anchor. Pinned in this file by default; an operator verifying
        # a build signed by someone else names theirs explicitly, and the output
        # says which was used.
        if args.allowed_signers:
            allowed_signers = Path(args.allowed_signers).read_text(encoding="utf-8")
        else:
            allowed_signers = "\n".join(PINNED_ALLOWED_SIGNERS) + "\n"
        trusted_pub = (_read_nofollow(Path(args.mldsa_pub), 16384)
                       if args.mldsa_pub else None)
        trust_anchor = ("operator-supplied" if args.allowed_signers or args.mldsa_pub
                        else "pinned")

        registry, reg_err = (None, None)
        if not args.skip_registry:
            registry, reg_err = _resolve_registry_digest(image)
        digest_match = None if registry is None else (registry == signed)

        ssh_ok, ssh_detail = _verify_ssh_signature(sigdir, args.identity,
                                                   digest_bytes, allowed_signers)
        pq_ok, pq_detail = _verify_mldsa_signature(sigdir, digest_bytes, trusted_pub)

        failures = []
        unchecked = []
        if args.skip_registry:
            unchecked.append("registry digest: not compared (--skip-registry)")
        elif registry is None:
            failures.append(f"could not resolve registry digest: {reg_err}")
        elif not digest_match:
            failures.append("registry digest does not match the signed digest")
        if ssh_ok is not True:
            failures.append(f"SSH-FIDO2 signature: {ssh_detail}")
        if pq_ok is False:
            failures.append(f"ML-DSA signature: {pq_detail}")
        elif pq_ok is None:
            unchecked.append(f"ML-DSA signature: {pq_detail}")
            # A hybrid signature with one half unexamined is not verified. This
            # used to exit 0 with a qualifier on the human line, so any caller
            # testing the exit status accepted an image whose post-quantum half
            # was never looked at: deleting both ML-DSA files, or running on a
            # host without pqsign, reduced the scheme to one classical signature.
            # Accepting that is now an explicit, visible decision.
            if not args.allow_classical_only:
                failures.append(
                    f"ML-DSA signature was not verified ({pq_detail}); half a "
                    "hybrid signature is not a verified image. Pass "
                    "--allow-classical-only to accept the SSH-FIDO2 signature alone")
        ok = not failures
        # `ok`: nothing refused the image. `complete`: nothing was left unrun.
        # They differ only when the operator opted out of a check explicitly
        # (--skip-registry, --allow-classical-only).
        complete = ok and not unchecked

        doc = {
            "image": image,
            "registry_digest": registry,
            "signed_digest": signed,
            "digest_match": digest_match,
            "ssh_fido2": ssh_ok,
            "ssh_fido2_detail": ssh_detail,
            "mldsa": pq_ok,
            "mldsa_detail": pq_detail,
            "trust_anchor": trust_anchor,
            "failures": failures,
            "unchecked": unchecked,
            "complete": complete,
        }
        if args.json:
            return emit_json(EXIT_OK if ok else EXIT_FAIL, **doc)
        print(f"image:           {image}")
        print(f"signed digest:   {signed}")
        print(f"registry digest: {registry or '(not checked)'}")
        print(f"ssh-fido2:       {ssh_ok} ({ssh_detail})")
        print(f"mldsa:           {pq_ok} ({pq_detail})")
        print(f"trust anchor:    {trust_anchor}")
        if not ok:
            print("NOT VERIFIED: " + "; ".join(failures))
        elif unchecked:
            print("VERIFIED, BUT NOT COMPLETELY: " + "; ".join(unchecked))
        else:
            print("VERIFIED")
        return EXIT_OK if ok else EXIT_FAIL
    except (ValueError, OSError) as exc:
        return emit_json(EXIT_USAGE, error=str(exc))


def cmd_sbom(args) -> int:
    try:
        eng = _engine()
        if eng is None:
            raise ValueError("neither docker nor podman found on PATH")
        if eng != "docker":
            raise ValueError("sbom currently requires the docker engine for its socket")
        image = validate_image_ref(args.image or build_manifest()["image"])
        args.syft_image = validate_image_ref(args.syft_image)
        proc = _run([eng, "run", "--rm",
                     "-v", "/var/run/docker.sock:/var/run/docker.sock",
                     args.syft_image, image, "-o", "spdx-json", "-q"])
        if proc.returncode != 0:
            raise RuntimeError((proc.stderr.strip() or "syft failed")[-400:])
        doc = json.loads(proc.stdout)
        # Normalise the two nondeterministic fields so the SBOM is stable.
        doc["documentNamespace"] = "https://sambent.dev/sbom/hiddenforge"
        doc.get("creationInfo", {}).pop("created", None)
        packages = len(doc.get("packages", []))
        if packages == 0:
            raise RuntimeError("syft returned an SBOM with zero packages")
        out = Path(args.out)
        _write_text_nofollow(out, json.dumps(doc, indent=2, sort_keys=True) + "\n", 0o644)
        if args.json:
            return emit_json(EXIT_OK, out=str(out), image=image, packages=packages,
                             syft_image=args.syft_image)
        print(f"Wrote {out} ({packages} packages)")
        return EXIT_OK
    except (ValueError, OSError, RuntimeError, json.JSONDecodeError) as exc:
        return emit_json(EXIT_USAGE if isinstance(exc, ValueError) else EXIT_FAIL,
                         error=str(exc))


# ---------------------------------------------------------------------------
# argparse
# ---------------------------------------------------------------------------

def _add_json(sp):
    sp.add_argument("--json", action="store_true",
                    help="emit one JSON document on stdout; narration goes to stderr")


def build_parser() -> argparse.ArgumentParser:
    ap = argparse.ArgumentParser(
        prog="hiddenforge",
        description="Hardened Tor v3 onion-service sidecar: operator CLI and machine "
                    "contract.",
        epilog="Every command accepts --json where it matters. See manifest.json / "
               "`hiddenforge info --json` for the machine contract.",
    )
    sub = ap.add_subparsers(required=True, dest="command")

    sp = sub.add_parser("setup", help="emit a compose fragment + deploy script")
    sp.add_argument("-o", "--out", default="./hiddenforge-deploy")
    sp.add_argument("--name", default=DEFAULT_NAME)
    sp.add_argument("--backend", default=None, help="backend service:port (e.g. web:80)")
    sp.add_argument("--onion-port", type=int, default=80)
    sp.add_argument("--service", action="append", default=None,
                    help="name:onionport:host:port (repeatable; multi-service)")
    sp.add_argument("--services", default=None,
                    help="name:onionport:host:port[,...] (full form, may be multi-service)")
    sp.add_argument("--image", default=DEFAULT_IMAGE)
    sp.add_argument("--keys", default=DEFAULT_KEYS)
    sp.add_argument("--container", default=DEFAULT_CONTAINER)
    sp.add_argument("--runtime", choices=["docker", "podman"], default="docker")
    sp.add_argument("--force", action="store_true",
                    help="overwrite an existing output directory")
    sp.add_argument("--non-interactive", action="store_true")
    _add_json(sp)
    sp.set_defaults(func=cmd_setup)

    sp = sub.add_parser("info", help="print the machine contract (manifest.json)")
    _add_json(sp)
    sp.set_defaults(func=cmd_info)

    sp = sub.add_parser("version", help="print name, version, contract version")
    _add_json(sp)
    sp.set_defaults(func=cmd_version)

    sp = sub.add_parser("show", help="print the .onion address(es)")
    sp.add_argument("--keys", default=str(_default_keys()))
    sp.add_argument("--name", default=None)
    sp.add_argument("--container", default=None,
                    help="ask this container (as the tor user) for an address the "
                         "host cannot read, e.g. under rootless Podman")
    _add_json(sp)
    sp.set_defaults(func=cmd_show)

    sp = sub.add_parser("status", help="container/Tor/hidden-service readiness")
    sp.add_argument("--container", default=DEFAULT_CONTAINER)
    sp.add_argument("--keys", default=str(_default_keys()))
    _add_json(sp)
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("doctor", help="verify hardening of the running container")
    sp.add_argument("--container", default=DEFAULT_CONTAINER)
    sp.add_argument("--keys", default=str(_default_keys()))
    sp.add_argument("--keys-only", action="store_true",
                    help="skip docker inspect; check on-disk key hygiene only")
    _add_json(sp)
    sp.set_defaults(func=cmd_doctor)

    sp = sub.add_parser("vanity", help="brute-force a vanity .onion prefix")
    sp.add_argument("--prefix", required=True)
    sp.add_argument("--name", default=DEFAULT_NAME)
    sp.add_argument("--keys", default=str(_default_keys()))
    sp.add_argument("--threads", type=int, default=0)
    sp.add_argument("--bench", action="store_true")
    sp.add_argument("--seconds", type=int, default=5)
    sp.add_argument("--force", action="store_true")
    sp.add_argument("--image", default=DEFAULT_IMAGE)
    _add_json(sp)
    sp.set_defaults(func=cmd_vanity)

    sp = sub.add_parser("backup", help="encrypted offline backup of the key volume")
    sp.add_argument("--keys", default=str(_default_keys()))
    sp.add_argument("--out", required=True)
    sp.add_argument("--tool", choices=["age", "gpg", "openssl"], default=None,
                    help="age (interactive TTY prompt only) | gpg (scriptable, via "
                         "--passphrase-file) | openssl (refused: unauthenticated)")
    sp.add_argument("--passphrase-file", default=None)
    sp.add_argument("--require-aead", action="store_true",
                    help="refuse to write a CFB+MDC backup (require authenticated encryption)")
    _add_json(sp)
    sp.set_defaults(func=cmd_backup)

    sp = sub.add_parser("restore", help="restore a previous backup")
    sp.add_argument("--keys", default=str(_default_keys()))
    sp.add_argument("--input", required=True)
    sp.add_argument("--tool", choices=["age", "gpg", "openssl"], default=None)
    sp.add_argument("--passphrase-file", default=None)
    sp.add_argument("--force", action="store_true")
    _add_json(sp)
    sp.set_defaults(func=cmd_restore)

    sp = sub.add_parser("rotate", help="DESTRUCTIVE: archive the identity and start over")
    sp.add_argument("--keys", default=str(_default_keys()))
    sp.add_argument("--confirm", default=None, help="must be the literal ROTATE")
    _add_json(sp)
    sp.set_defaults(func=cmd_rotate)

    for cmd, fn, helptext in (
        ("encrypt-key", cmd_encrypt_key, "encrypt a service key directory at rest (offline)"),
        ("decrypt-key", cmd_decrypt_key, "restore a key directory from its archive"),
    ):
        sp = sub.add_parser(cmd, help=helptext)
        sp.add_argument("--keys", default=str(_default_keys()))
        sp.add_argument("--name", required=True)
        sp.add_argument("--tool", choices=["age", "gpg"], default=None,
                        help="age (interactive TTY prompt only) | gpg (scriptable, "
                             "via --passphrase-file)")
        sp.add_argument("--passphrase-file", default=None)
        sp.add_argument("--delete-plaintext", action="store_true")
        sp.add_argument("--force", action="store_true")
        sp.add_argument("--require-aead", action="store_true",
                        help="refuse a CFB+MDC envelope (require authenticated encryption)")
        _add_json(sp)
        sp.set_defaults(func=fn)

    sp = sub.add_parser("verify-image", help="verify the signed image digest")
    sp.add_argument("image", nargs="?", default=None)
    sp.add_argument("--sigdir", default=DEFAULT_SIGNATURE_DIR)
    sp.add_argument("--identity", default=DEFAULT_SIGN_IDENTITY)
    sp.add_argument("--skip-registry", action="store_true",
                    help="verify signatures only; do not query the registry")
    sp.add_argument("--allow-classical-only", action="store_true",
                    help="accept the image when the ML-DSA half could not be checked "
                         "(reported as complete: false)")
    sp.add_argument("--allowed-signers", default=None,
                    help="trust this ssh allowed_signers file instead of the pinned "
                         "release keys (for images you or someone else signed)")
    sp.add_argument("--mldsa-pub", default=None,
                    help="trust this ML-DSA public key instead of the pinned one")
    _add_json(sp)
    sp.set_defaults(func=cmd_verify_image)

    sp = sub.add_parser("sbom", help="generate an SPDX SBOM for an image")
    sp.add_argument("--image", default=None)
    sp.add_argument("--out", default="./hiddenforge.spdx.json")
    sp.add_argument("--syft-image", default=SYFT_IMAGE)
    _add_json(sp)
    sp.set_defaults(func=cmd_sbom)

    return ap


def _harden_streams() -> None:
    """Make stdout/stderr survive a lone surrogate.

    A non-UTF-8 --keys path decodes to a surrogate, and printing one raises
    UnicodeEncodeError, turning a clean error message into a traceback. Escape
    on the way out instead. Guarded because captured streams (tests) and some
    wrappers have no reconfigure().
    """
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            stream.reconfigure(errors="backslashreplace")


def main(argv: list[str] | None = None) -> int:
    _harden_streams()
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except KeyboardInterrupt:
        _eprint("interrupted")
        return EXIT_ABORTED


if __name__ == "__main__":
    sys.exit(main())
