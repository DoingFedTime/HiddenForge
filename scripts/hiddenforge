def _registered_commands() -> list[str]:
    """The subcommand names the parser actually registers.

    Read from argparse rather than a hand-kept list, so this is the source of
    truth: manifest.json's `commands` is checked against it in CI, which is what
    makes the manifest/code drift check real.
    """
    for action in build_parser()._actions:
        if isinstance(action, argparse._SubParsersAction):
            return sorted(action.choices)
    return []


