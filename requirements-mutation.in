# Direct dependencies for the MUTATION gate only, kept out of requirements-ci.in
# on purpose.
#
# mutmut pulls in thirteen packages the rest of the toolchain does not need --
# libcst to rewrite the source, and textual/rich/pygments/markdown-it for a
# progress display CI never looks at. Adding those to the venv that lints and
# tests the code would widen the trust boundary of every job for the benefit of
# one, so the mutation job builds its own.
#
# Transitively pinned, with hashes, in requirements-mutation.txt (generated,
# do not edit by hand):
#
#     .venv/bin/pip-compile --generate-hashes requirements-mutation.in
#
# Installed with --require-hashes, same standard as requirements-ci.txt.
# The version matches the one the dev venv runs, so a kill rate measured locally
# and one measured in CI are the same measurement.
mutmut==3.5.0
pytest==9.0.3
hypothesis==6.155.1
# Pinned to the same version requirements-ci.in uses. mutmut would otherwise pull
# whatever coverage is current, and the two jobs would be running the suite
# against different instrumentation.
coverage==7.14.1
