# Direct dependencies for the CI toolchain. Transitively pinned, with hashes, in
# requirements-ci.txt (generated, do not edit by hand):
#
#     .venv/bin/pip-compile --generate-hashes requirements-ci.in
#
# It is installed with `--require-hashes`, matching the standard the Dockerfile
# already applies to the image's own dependencies. The gate must not be fetched
# with weaker integrity than the thing it gates.
#
# Versions are pinned exactly and match the ones the Dockerfile/venv use, so the
# lint job type-checks against the same stubs the unit job runs against.
ruff==0.15.16
mypy==2.2.0
pytest==9.0.3
hypothesis==6.155.1
coverage==7.14.1
pytest-cov==7.1.0
# The compose fragment and the deploy script are checked by PARSING them, not
# by matching strings: `privileged: true` smuggled into a key path is a YAML
# question. Without this, those tests called pytest.importorskip and SKIPPED in
# CI -- measured: the mutation spot-check reported the container-escape guard
# SURVIVED, because the only test that kills it was never run here.
PyYAML==6.0.3
# Stubs, because the lint job type-checks the tests too and an untyped
# import is an error there.
types-PyYAML==6.0.12.20250915
